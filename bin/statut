#!/usr/bin/env bash
# Usage : repowarden statut   (ou repowarden, sans argument)
#
# État de repowarden sur ce poste et dans le dépôt courant, puis la commande
# suivante à lancer (l'équivalent de « gh auth status » ou « brew doctor »).
# Lecture seule : rien n'est modifié.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"
exec 2>&1 # une seule sortie, dans l'ordre (avertissements compris)
# shellcheck disable=SC2034 # lu par check_version (common.sh)
HOOKS_DIR="$ROOT/hooks"

repowarden_version_r "$ROOT"
version="$REPLY"
case "$ROOT" in
    */node_modules/*) mode=npm ;;
    *) mode=clone ;;
esac
suivant="" # première action à faire, affichée à la fin

reel() { [ -d "$1" ] && (cd "$1" && pwd -P); }

brand "${version:-?} · $mode · $ROOT"

# Hooks globaux : ceux de cette installation, d'une autre, ou d'un autre outil
global="$(git config --global --get core.hooksPath 2>/dev/null || true)"
local_hooks="$(git config --local --get core.hooksPath 2>/dev/null || true)"
if [ -z "$global" ] && [ -n "$local_hooks" ] && [ "$(reel "$local_hooks")" = "$ROOT/hooks" ]; then
    # Installation locale (install.sh sans --global) : active dans ce dépôt
    ok_t st.hooks_repo
elif [ -z "$global" ]; then
    err_t st.hooks_off
    suivant="${suivant:-repowarden install --global}"
elif [ "$(reel "$global")" = "$ROOT/hooks" ]; then
    ok_t st.hooks_on
elif [ -f "$global/lib/common.sh" ] && grep -qsE "repowarden|repogarde" "$global/lib/common.sh"; then
    attention_t st.hooks_other "$global"
    suivant="${suivant:-repowarden install --global}"
else
    info_t st.hooks_foreign "$global"
fi

# Assistant de commit (git cc) : valeur effective, installation locale comprise
alias_cc="$(git config --get alias.cc 2>/dev/null || true)"
if [[ "$alias_cc" == *"$ROOT/bin/commit"* ]]; then
    ok_t st.cc_on
elif [[ "$alias_cc" == *"/bin/commit"* ]]; then
    attention_t st.cc_other
    suivant="${suivant:-repowarden install --global}"
elif [ -n "$alias_cc" ]; then
    info_t st.cc_foreign "$alias_cc"
else
    err_t st.cc_off
    suivant="${suivant:-repowarden install --global}"
fi

info_t st.lang "$REPOWARDEN_LANG"

# Dépôt courant
if [ -n "$GIT_TOPLEVEL" ]; then
    step_t st.repo "$GIT_TOPLEVEL"
    local_path="$(git config --local --get core.hooksPath 2>/dev/null || true)"
    if [ -n "$local_path" ]; then
        info_t st.repo_local "$local_path"
    fi
    for f in lefthook.yml lefthook.yaml .lefthook.yml .lefthook.yaml; do
        [ -f "$GIT_TOPLEVEL/$f" ] || continue
        attention_t st.repo_lefthook "$f"
        break
    done
    # Anciens noms (configuration, workflows de l'ancien dépôt, que GitHub ne
    # redirige plus) : la migration les remplace
    if [ -e "$GIT_TOPLEVEL/.repogarde.conf" ] || [ -d "$GIT_TOPLEVEL/.repogarde" ] ||
        grep -qs repogarde "$GIT_TOPLEVEL"/.github/workflows/*.y*ml; then
        attention_t st.repo_migrate
        suivant="${suivant:-repowarden migrer}"
    fi
    # Branche develop présente, flux non déclaré : traité comme « main seule »
    cfg_r integrationBranch ""
    if [ -z "$REPLY" ] && git rev-parse -q --verify refs/remotes/origin/develop >/dev/null; then
        attention_t st.repo_develop_undeclared
    fi
    cfg_r version ""
    if [ -n "$REPLY" ]; then
        attendue="${REPLY#v}"
        if [ -n "$(check_version 2>&1)" ]; then
            attention_t st.repo_version_old "$attendue" "${version:-?}"
            [ "$mode" = npm ] && suivant="${suivant:-npm update -g repowarden}"
        else
            ok_t st.repo_version_ok "$attendue"
        fi
    fi
    info_t st.repo_forge "$FORGE"
    [ "$FORGE" != github ] || dim_t st.repo_rules
fi

# Outils : secrets, code mort (selon les langages)
presents="" absents=""
for outil in gitleaks ruff vulture staticcheck pmd; do
    if has "$outil"; then presents="$presents $outil"; else absents="$absents $outil"; fi
done
info_t st.tools "${presents# }" "${absents# }"

echo
if [ -n "$suivant" ]; then
    t st.next
    printf '%s %s%s%s\n' "$REPLY" "$UI_B" "$suivant" "$UI_N"
else
    ok_t st.ready
fi
dim_t st.help
