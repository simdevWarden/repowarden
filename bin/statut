#!/usr/bin/env bash
# Usage : repowarden statut   (ou repowarden, sans argument)
#
# État de repowarden sur ce poste et dans le dépôt courant, puis la commande
# suivante à lancer (l'équivalent de « gh auth status » ou « brew doctor »).
# Lecture seule : rien n'est modifié.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"
# shellcheck source=../hooks/lib/secrets.sh
source "$ROOT/hooks/lib/secrets.sh"
# shellcheck source=../hooks/lib/agents.sh
source "$ROOT/hooks/lib/agents.sh"
# shellcheck source=../hooks/lib/carte.sh
source "$ROOT/hooks/lib/carte.sh"
exec 2>&1 # une seule sortie, dans l'ordre (avertissements compris)
# shellcheck disable=SC2034 # lu par check_version (common.sh)
HOOKS_DIR="$ROOT/hooks"

repowarden_version_r "$ROOT"
version="$REPLY"
case "$ROOT" in
    */node_modules/*) mode=npm ;;
    *) mode=clone ;;
esac
suivant="" # première action à faire, affichée à la fin

reel() { [ -d "$1" ] && (cd "$1" && pwd -P); }

brand "${version:-?} · $mode · $ROOT"

# Hooks globaux : ceux de cette installation, d'une autre, ou d'un autre outil
global="$(git config --global --get core.hooksPath 2>/dev/null || true)"
local_hooks="$(git config --local --get core.hooksPath 2>/dev/null || true)"
if [ -z "$global" ] && [ -n "$local_hooks" ] && [ "$(reel "$local_hooks")" = "$ROOT/hooks" ]; then
    # Installation locale (install.sh sans --global) : active dans ce dépôt
    ok_t st.hooks_repo
elif [ -z "$global" ]; then
    err_t st.hooks_off
    suivant="${suivant:-repowarden install --global}"
elif [ "$(reel "$global")" = "$ROOT/hooks" ]; then
    ok_t st.hooks_on
elif [ -f "$global/lib/common.sh" ] && grep -qsE "repowarden|repogarde" "$global/lib/common.sh"; then
    attention_t st.hooks_other "$global"
    suivant="${suivant:-repowarden install --global}"
else
    info_t st.hooks_foreign "$global"
fi

# Assistant de commit (git cc) : valeur effective, installation locale comprise
alias_cc="$(git config --get alias.cc 2>/dev/null || true)"
if [[ "$alias_cc" == *"$ROOT/bin/commit"* ]]; then
    ok_t st.cc_on
elif [[ "$alias_cc" == *"/bin/commit"* ]]; then
    attention_t st.cc_other
    suivant="${suivant:-repowarden install --global}"
elif [ -n "$alias_cc" ]; then
    info_t st.cc_foreign "$alias_cc"
else
    err_t st.cc_off
    suivant="${suivant:-repowarden install --global}"
fi

info_t st.lang "$REPOWARDEN_LANG"

# Dépôt courant
if [ -n "$GIT_TOPLEVEL" ]; then
    step_t st.repo "$GIT_TOPLEVEL"
    local_path="$(git config --local --get core.hooksPath 2>/dev/null || true)"
    if [ -n "$local_path" ]; then
        info_t st.repo_local "$local_path"
    fi
    for f in lefthook.yml lefthook.yaml .lefthook.yml .lefthook.yaml; do
        [ -f "$GIT_TOPLEVEL/$f" ] || continue
        attention_t st.repo_lefthook "$f"
        break
    done
    # Projet pre-commit : avec les hooks repowarden actifs, « pre-commit install »
    # refuse ; ses hooks ne tournent que dans .git/hooks ou .repowarden, lancés par repowarden
    if [ -f "$GIT_TOPLEVEL/.pre-commit-config.yaml" ] &&
        [ "$(reel "$(git config --get core.hooksPath 2>/dev/null || true)")" = "$ROOT/hooks" ]; then
        commun="$(cd "$GIT_TOPLEVEL" && reel "$(git rev-parse --git-common-dir)")"
        lance=""
        for h in "$commun/hooks/pre-commit" "$GIT_TOPLEVEL/.repowarden/pre-commit"; do
            [ -x "$h" ] && grep -qsE 'File generated by pre-commit|pre-commit +(run|hook-impl)' "$h" && lance=1
        done
        if [ -z "$lance" ]; then
            marche="GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0= pre-commit install"
            attention_t st.repo_precommit "$marche"
            suivant="${suivant:-$marche}"
        fi
    fi
    # Anciens noms (configuration, workflows de l'ancien dépôt, que GitHub ne
    # redirige plus) : la migration les remplace
    if [ -e "$GIT_TOPLEVEL/.repogarde.conf" ] || [ -d "$GIT_TOPLEVEL/.repogarde" ] ||
        grep -qs repogarde "$GIT_TOPLEVEL"/.github/workflows/*.y*ml; then
        attention_t st.repo_migrate
        suivant="${suivant:-repowarden migrer}"
    fi
    # Workflows qui appellent repowarden : dépôt officiel et tag vN de la
    # majeure installée. Autre dépôt (ancien propriétaire, fork), branche
    # (cassé quand elle disparaît) ou majeure dépassée : la ligne à corriger
    repowarden_majeure_r "$version"
    majeure="$REPLY"
    re_uses='^[[:space:]]*(-[[:space:]]+)?uses:[[:space:]]*["'"'"']?([A-Za-z0-9_.-]+)/repowarden(/[^@[:space:]"'"'"']*)?@([^[:space:]"'"'"'#]+)'
    re_tag='^v([0-9]+)(\.[0-9]+)*(-[0-9A-Za-z.]+)?$'
    re_sha='^[0-9a-f]{40}$'
    for wf in "$GIT_TOPLEVEL"/.github/workflows/*.yml "$GIT_TOPLEVEL"/.github/workflows/*.yaml; do
        [ -f "$wf" ] || continue
        n=0
        while IFS= read -r ligne || [ -n "$ligne" ]; do
            n=$((n + 1))
            [[ "$ligne" =~ $re_uses ]] || continue
            proprio="${BASH_REMATCH[2]}" chemin="${BASH_REMATCH[3]}" ref="${BASH_REMATCH[4]}"
            attendu="simdevWarden/repowarden$chemin@v${majeure:-N}"
            shopt -s nocasematch
            officiel=""
            [[ "$proprio" != simdevwarden ]] || officiel=1
            shopt -u nocasematch
            cle=""
            if [ -z "$officiel" ]; then
                cle=st.wf_owner arg="$proprio/repowarden"
            elif [[ "$ref" =~ $re_tag ]]; then
                if [ -n "$majeure" ] && [ "${BASH_REMATCH[1]}" -lt "$majeure" ]; then
                    cle=st.wf_old arg="$ref"
                fi
            elif ! [[ "$ref" =~ $re_sha ]]; then
                cle=st.wf_branch arg="$ref"
            fi
            [ -n "$cle" ] || continue
            attention_t "$cle" "${wf#"$GIT_TOPLEVEL"/}" "$n" "$arg" "$attendu"
            t st.wf_fix
            suivant="${suivant:-$REPLY}"
        done <"$wf"
    done
    # Branche develop présente, flux non déclaré : traité comme « main seule »
    cfg_r integrationBranch ""
    if [ -z "$REPLY" ] && git rev-parse -q --verify refs/remotes/origin/develop >/dev/null; then
        attention_t st.repo_develop_undeclared
    fi
    cfg_r version ""
    if [ -n "$REPLY" ]; then
        attendue="${REPLY#v}"
        if [ -n "$(check_version 2>&1)" ]; then
            attention_t st.repo_version_old "$attendue" "${version:-?}"
            [ "$mode" = npm ] && suivant="${suivant:-npm update -g repowarden}"
        else
            ok_t st.repo_version_ok "$attendue"
        fi
    fi
    # Fichier sensible ni suivi ni ignoré (même avertissement qu'au pre-commit)
    if ! skipped secrets && ! skipped sensitive-files; then
        sensitive_files_r
        [ -z "$REPLY" ] || sensitive_files_warn "$REPLY"
    fi
    # Carte du projet (repowarden carte) : facultative ; périmée, elle ne dit
    # plus ce que fait le code, et les agents la lisent avant de modifier
    if [ ! -f "$GIT_TOPLEVEL/$CARTE_JSON" ]; then
        info_t st.carte_absente
    elif (cd "$GIT_TOPLEVEL" && carte_a_jour); then
        ok_t st.carte_ok
    else
        attention_t st.carte_perimee
        suivant="${suivant:-repowarden carte}"
    fi
    info_t st.repo_forge "$FORGE"
    [ "$FORGE" != github ] || dim_t st.repo_rules
fi

# Agent IA sans garde-fou : ses actions ne seraient vérifiées qu'au commit.
# Branché dans le dépôt (à versionner), ou pour l'utilisateur hors dépôt
if agents_sans_garde "$GIT_TOPLEVEL"; then
    cmd_agents="repowarden agents init"
    [ -n "$GIT_TOPLEVEL" ] || cmd_agents="repowarden agents init --global"
    attention_t st.agents_sans_garde "$cmd_agents"
    suivant="${suivant:-$cmd_agents}"
fi
# Garde-fou posé par une version antérieure de repowarden : init le met à jour
while read -r portee _agent fichier; do
    cmd_agents="repowarden agents init"
    [ "$portee" = projet ] || cmd_agents="$cmd_agents --global"
    attention_t st.agents_stale "$fichier" "$cmd_agents"
    suivant="${suivant:-$cmd_agents}"
done < <(agents_perimes "$GIT_TOPLEVEL")

# Outils : secrets, code mort (selon les langages)
presents="" absents=""
for outil in gitleaks ruff vulture staticcheck pmd; do
    if has "$outil"; then presents="$presents $outil"; else absents="$absents $outil"; fi
done
info_t st.tools "${presents# }" "${absents# }"
# Sans gitleaks, les secrets ne sont vérifiés que par la CI
if ! has gitleaks && ! skipped secrets; then
    gitleaks_install_r
    suivant="${suivant:-$REPLY}"
fi

echo
if [ -n "$suivant" ]; then
    t st.next
    printf '%s %s%s%s\n' "$REPLY" "$UI_B" "$suivant" "$UI_N"
else
    ok_t st.ready
fi
dim_t st.help
