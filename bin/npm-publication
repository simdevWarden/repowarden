#!/usr/bin/env bash
# Publication npm automatique d'un dépôt, mise en place en une commande :
# chaque release publie le paquet (workflow npm-publish.yml), sans jeton : npm
# vérifie que la publication vient de ce dépôt et de release.yml (publication
# de confiance, OIDC) et joint la provenance au paquet.
#
#   bin/npm-publication [--repo propriétaire/nom] [--workflow release.yml]
#                       [--environnement NOM] [--dry-run]
#
# 1. connexion npm (npm login si besoin) ;
# 2. paquet absent de npm (la publication de confiance exige un paquet
#    existant) : la dernière release est publiée d'ici, par npm publish lancé
#    dans le terminal (npm conduit sa validation : navigateur ou code) ;
#    aucune release : rien n'est publié, relancer après la première ;
# 3. publication de confiance (npm trust github), variable REPOWARDEN_NPM ;
#    un ancien secret NPM_TOKEN et d'anciens jetons temporaires sont retirés.
#    Interrompue, la commande reprend où elle en était.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

REPO=""
WORKFLOW="release.yml"
ENVIRONMENT=""
DRY_RUN=false
while [ $# -gt 0 ]; do
    case "$1" in
        --repo) shift; REPO="${1:?--repo attend propriétaire/nom}" ;;
        --workflow) shift; WORKFLOW="${1:?--workflow attend un fichier}" ;;
        --environnement | --environment) shift; ENVIRONMENT="${1:?--environnement attend un nom}" ;;
        --dry-run) DRY_RUN=true ;;
        -h | --help) _tr help.npm-publication; printf '%b\n' "$_T"; exit 0 ;;
        *) err_t install.unknown_arg "$1"; exit 1 ;;
    esac
    shift
done

command -v gh >/dev/null || { err_t bot.no_gh; exit 1; }
command -v npm >/dev/null || { err_t npm.no_npm; exit 1; }
# npm trust : npm 11.15 au minimum
if ! node -e 'const [a,b]=process.argv[1].split(".").map(Number);process.exit(a>11||(a==11&&b>=15)?0:1)' "$(npm --version)"; then
    err_t npm.old_npm "$(npm --version)"
    exit 1
fi
cd "$GIT_TOPLEVEL"
[ -f package.json ] || { err_t npm.no_package; exit 1; }
if [ -z "$REPO" ]; then
    REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
else
    # Dépôt vérifié avant toute action : une faute de frappe (« own/nom, »)
    # serait sinon prise plus loin pour un dépôt sans release
    [[ "$REPO" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || { err_t npm.bad_repo "$REPO"; exit 1; }
    gh repo view "$REPO" --json nameWithOwner >/dev/null || { err_t npm.repo_unreachable "$REPO"; exit 1; }
fi
name="$(node -p 'require("./package.json").name')"
# Préfixe des jetons temporaires de l'ancien parcours, révoqués à la fin
TOKEN_PREFIX="repowarden-ci-${REPO##*/}"

# Vérifie si une relation de confiance correspond aux paramètres attendus.
# Affiche l'écart si --dry-run ou pour confirmation.
# Retourne : 0 = match, 1 = pas de relation, 2 = relation différente
verifier_trust() {
    local json attendu_repo="$REPO" attendu_file="$WORKFLOW" attendu_env="$ENVIRONMENT"
    json="$(npm trust list "$name" --json 2>/dev/null || echo '[]')"
    if [ "$json" = "[]" ] || [ -z "$json" ]; then
        return 1
    fi
    local match=0 id repo file env allow_publish
    while IFS=$'\t' read -r id repo file env allow_publish; do
        [ -n "$id" ] || continue
        if [ "$repo" = "$attendu_repo" ] && [ "$file" = "$attendu_file" ] && [ "$env" = "$attendu_env" ] && [ "$allow_publish" = "true" ]; then
            match=1
            break
        fi
    done < <(node -e "
        const data = $json;
        for (const t of data) {
            const id = t.id || t.key;
            const repo = t.repository || t.repo || '';
            const file = t.file || t.workflow || '';
            const env = t.environment || t.env || '';
            const allowPublish = t.allowPublish === true || t['allow-publish'] === true;
            console.log(id + '\t' + repo + '\t' + file + '\t' + env + '\t' + allowPublish);
        }
    ")
    if [ "$match" = 1 ]; then
        return 0
    fi
    return 2
}

# Affiche les détails d'une relation de confiance pour diagnostic
afficher_trust() {
    local json
    json="$(npm trust list "$name" --json 2>/dev/null || echo '[]')"
    if [ "$json" = "[]" ] || [ -z "$json" ]; then
        echo "  (aucune relation de confiance)"
        return
    fi
    node -e "
        const data = $json;
        for (const t of data) {
            const id = t.id || t.key;
            const repo = t.repository || t.repo || '(inconnu)';
            const file = t.file || t.workflow || '(inconnu)';
            const env = t.environment || t.env || '(aucun)';
            const allowPublish = t.allowPublish === true || t['allow-publish'] === true;
            const allowStagePublish = t.allowStagePublish === true || t['allow-stage-publish'] === true;
            console.log('  ID: ' + id);
            console.log('  Dépôt: ' + repo);
            console.log('  Workflow: ' + file);
            console.log('  Environnement: ' + env);
            console.log('  npm publish: ' + (allowPublish ? 'oui' : 'non'));
            console.log('  npm stage publish: ' + (allowStagePublish ? 'oui' : 'non'));
            console.log('');
        }
    "
}

brand "npm · $name · $REPO"

# 1. Connexion npm : entre toi et npm (navigateur ou mot de passe)
step_t npm.step_login
npm whoami >/dev/null 2>&1 || npm login
ok_t npm.logged "$(npm whoami)"
# Configurer la publication de confiance exige la 2FA du compte (les codes
# envoyés par e-mail ne sont qu'une vérification de connexion)
if [ "$(npm profile get --json 2>/dev/null | node -e 'try{const p=JSON.parse(require("fs").readFileSync(0,"utf8"));process.stdout.write(p.tfa&&p.tfa.mode?"1":"")}catch{}')" != 1 ]; then
    err_t npm.no_2fa
    dim_t npm.hint_2fa "$(npm whoami)"
    exit 1
fi

publie() { [ -n "$(npm view "$name" name 2>/dev/null || true)" ]; }

# 2. Première publication, faite ici depuis la dernière release : npm conduit
# lui-même sa validation (navigateur ou code), dans le terminal. Aucun jeton
# créé ni stocké, aucun mot de passe saisi par repowarden
if ! publie; then
    step_t npm.step_first
    # Seul « release not found » signifie « aucune release » ; toute autre
    # erreur de gh (réseau, droits) est rapportée telle quelle
    gh_err="$(mktemp "${TMPDIR:-/tmp}/repowarden-gh.XXXXXX")"
    tag="$(gh release view --repo "$REPO" --json tagName -q .tagName 2>"$gh_err")" || tag=""
    msg="$(cat "$gh_err")"
    rm -f "$gh_err"
    if [ -z "$tag" ]; then
        if [ -n "$msg" ] && ! grep -qi 'release not found' <<<"$msg"; then
            err_t npm.release_error "$REPO" "$msg"
            exit 1
        fi
        attention_t npm.no_release "$name"
        exit 0
    fi
    version="${tag#v}"
    if [ "$DRY_RUN" = true ]; then
        info_t npm.would_publish "$name" "$version" "$tag"
        exit 0
    fi
    clone="$(mktemp -d "${TMPDIR:-/tmp}/repowarden-npm.XXXXXX")"
    trap 'rm -rf "$clone"' EXIT
    gh repo clone "$REPO" "$clone/src" -- -q --depth 1 --branch "$tag"
    info_t npm.publishing "$name" "$version" "$tag"
    # Sortie non capturée, entrée héritée : npm pose ses questions lui-même
    if ! (cd "$clone/src" && npm pkg set "version=$version" && npm publish --access public); then
        err_t npm.publish_failed "$name"
        exit 1
    fi
    rm -rf "$clone"
    trap - EXIT
    ok_t npm.first_published "$name" "$version"
fi

# 3. Publication de confiance, puis plus aucun jeton
step_t npm.step_trust
# Pas de relation (1) ou relation différente (2) : ne doit pas arrêter le script (set -e)
cas=0
verifier_trust || cas=$?
if [ "$cas" = 0 ]; then
    ok_t npm.trust_exists
elif [ "$cas" = 1 ]; then
    # Aucune relation : créer
    if [ "$DRY_RUN" = true ]; then
        info_t npm.trust_would_create "$REPO" "$WORKFLOW" "${ENVIRONMENT:-(aucun)}"
    else
        npm trust github "$name" --file "$WORKFLOW" --repo "$REPO" ${ENVIRONMENT:+--env "$ENVIRONMENT"} --allow-publish --yes
        ok_t npm.trust_set "$REPO" "$WORKFLOW"
    fi
else
    # Relation différente : afficher l'écart, demander confirmation, corriger sans perte
    attention_t npm.trust_mismatch
    afficher_trust
    echo "  Attendu :"
    echo "  Dépôt: $REPO"
    echo "  Workflow: $WORKFLOW"
    echo "  Environnement: ${ENVIRONMENT:-(aucun)}"
    echo "  npm publish: oui"
    echo ""
    if [ "$DRY_RUN" = true ]; then
        info_t npm.trust_would_fix
    else
        # Confirmation avant changement
        if [ -t 0 ]; then
            t npm.trust_confirm
            read -r -p "  $REPLY" rep
            echo
            [[ "$rep" =~ ^[OoYy]$ ]] || { err_t npm.trust_cancelled; exit 1; }
        fi
        # Créer la nouvelle relation AVANT de révoquer l'ancienne (pas de perte)
        npm trust github "$name" --file "$WORKFLOW" --repo "$REPO" ${ENVIRONMENT:+--env "$ENVIRONMENT"} --allow-publish --yes
        ok_t npm.trust_set "$REPO" "$WORKFLOW"
        # Révoquer l'ancienne relation
        json="$(npm trust list "$name" --json 2>/dev/null || echo '[]')"
        old_id="$(node -e "
            const data = $json;
            for (const t of data) {
                const id = t.id || t.key;
                const repo = t.repository || t.repo || '';
                const file = t.file || t.workflow || '';
                const env = t.environment || t.env || '';
                const allowPublish = t.allowPublish === true || t['allow-publish'] === true;
                if (repo !== '$REPO' || file !== '$WORKFLOW' || env !== '$ENVIRONMENT' || allowPublish !== true) {
                    console.log(id);
                }
            }
        ")"
        for id in $old_id; do
            [ -n "$id" ] && npm trust revoke "$name" --id "$id" --yes && ok_t npm.trust_revoked "$id"
        done
    fi
fi
gh variable set REPOWARDEN_NPM --repo "$REPO" --body true
if grep -q '^NPM_TOKEN' <<<"$(gh secret list --repo "$REPO")"; then
    if [ "$cas" = 0 ] || [ "$cas" = 2 ]; then
        # Relation de confiance OK (ou corrigée) : signaler le token et proposer suppression
        attention_t npm.token_present
        if [ "$DRY_RUN" = true ]; then
            info_t npm.token_would_remove
        elif [ -t 0 ]; then
            t npm.token_remove_confirm
            read -r -p "  $REPLY" rep
            echo
            [[ "$rep" =~ ^[OoYy]$ ]] && gh secret delete NPM_TOKEN --repo "$REPO" && ok_t npm.token_removed
        else
            gh secret delete NPM_TOKEN --repo "$REPO"
            ok_t npm.token_removed
        fi
    else
        # Pas de relation de confiance : supprimer silencieusement (comportement existant)
        gh secret delete NPM_TOKEN --repo "$REPO"
        ok_t npm.token_removed
    fi
fi
# Jetons temporaires révoqués sur npm (retrouvés par leur préfixe). npm peut
# demander un code 2FA : la commande garde le terminal (questions visibles)
ids="$({ npm token list --json 2>/dev/null || true; } |
    TOKEN_PREFIX="$TOKEN_PREFIX" node -e '
        let l = []; try { l = JSON.parse(require("fs").readFileSync(0, "utf8")); } catch {}
        const p = process.env.TOKEN_PREFIX;
        for (const t of [].concat(l)) if (t && typeof t.name === "string" && (t.name === p || t.name.startsWith(p + "-"))) console.log(t.id || t.key);')"
for id in $ids; do
    npm token revoke "$id" && ok_t npm.token_revoked
done
ok_t npm.done "$name"
