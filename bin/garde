#!/usr/bin/env bash
# Garde-fou des agents IA : reçoit sur l'entrée standard une action d'agent
# (JSON) et dit si elle est permise dans ce dépôt, avant qu'elle ne s'exécute.
#   repowarden garde [--format claude|opencode]
#     claude    hook PreToolUse de Claude Code : tool_name, tool_input, cwd
#     opencode  plugin opencode (tool.execute.before) : tool, args, cwd (défaut)
# Code 0 : permis. Code 2 : refusé, raison et commande à lancer sur la sortie
# d'erreur (Claude Code bloque l'appel et transmet le message à l'agent ; le
# plugin opencode lève une erreur). Tout autre code (jq absent, JSON illisible)
# n'empêche rien : une panne du garde-fou ne bloque jamais un agent.
# Seulement dans un dépôt repowarden ; ailleurs tout est permis. Mêmes réglages
# que les hooks (protectedBranches, integrationBranch, suivi des tickets).
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"
# shellcheck source=../hooks/lib/tickets.sh
source "$ROOT/hooks/lib/tickets.sh"

aide() { _tr help.garde; printf '%b\n' "$_T"; }

format=opencode
while [ $# -gt 0 ]; do
    case "$1" in
        -h | --help) aide; exit 0 ;;
        --format) shift; format="${1:-}" ;;
        --format=*) format="${1#--format=}" ;;
        *) err_t install.unknown_arg "$1"; aide >&2; exit 1 ;;
    esac
    shift
done
case "$format" in claude | opencode) ;; *) err_t garde.format "$format"; exit 1 ;; esac

has jq || { attention_t garde.no_jq; exit 1; }
entree="$(cat)"
if [ "$format" = claude ]; then o=tool_name a=tool_input; else o=tool a=args; fi
outil="$(jq -r ".$o // \"\"" <<<"$entree" 2>/dev/null)" || { attention_t garde.json; exit 1; }
cwd="$(jq -r '.cwd // ""' <<<"$entree")"
args="$(jq -c ".$a // {}" <<<"$entree")"
[ -n "$cwd" ] && [ -d "$cwd" ] || cwd="$PWD"

# Refus : raison et commande à lancer, puis code 2. Ligne shell de plusieurs
# commandes (LIGNE_MULTIPLE) : refusée en bloc, ce que l'agent doit savoir
LIGNE_MULTIPLE=""
# Fichier existant dont la modification est vérifiée (chemin depuis la racine) :
# un refus rappelle de lire sa carte avant de le modifier
FICHIER_CARTE=""
refuser() {
    _tr "$@"
    printf '✖ repowarden : %b\n' "$_T" >&2
    [ -z "$LIGNE_MULTIPLE" ] || { _tr garde.ligne_entiere; printf '%b\n' "$_T" >&2; }
    [ -z "$FICHIER_CARTE" ] || { _tr garde.carte "$FICHIER_CARTE" "$FICHIER_CARTE"; printf '%b\n' "$_T" >&2; }
    exit 2
}

# REPLY = dossier existant le plus proche du chemin $1 (absolu, ou relatif à $cwd)
dossier_r() {
    local p="$1"
    # Absolu : /…, ou C:/… et C:\… (Windows, #498)
    case "$p" in /* | [A-Za-z]:[/\\]*) ;; *) p="$cwd/$p" ;; esac
    while [ ! -d "$p" ] && [ "$p" != / ] && [ -n "$p" ]; do p="$(dirname "$p")"; done
    REPLY="$p"
}

# workdir d'opencode lu une fois : dossier de départ demandé par l'agent pour
# sa commande ; vide si absent (format Claude) ou non renseigné. #498
workdir="$(jq -r '.workdir // ""' <<<"$args")"

# Vrai si les hooks repowarden sont actifs dans le dépôt courant : le
# core.hooksPath en vigueur (local, sinon global) est un dossier de hooks
# repowarden. Chemin relatif : depuis la racine du dépôt, comme git
hooks_actifs() {
    local hp
    hp="$(git config --get core.hooksPath 2>/dev/null || true)"
    [ -n "$hp" ] || return 1
    # Absolu : /…, ou C:/… et C:\… (git pour Windows : Git Bash convertit
    # le chemin passé à git config)
    case "$hp" in
        \~/*) hp="$HOME/${hp#\~/}" ;;
        /* | [A-Za-z]:[/\\]*) ;;
        *) hp="$(git rev-parse --show-toplevel)/$hp" ;;
    esac
    [ -f "$hp/commit-msg" ] && [ -f "$hp/lib/common.sh" ] && [ -f "$hp/lib/tickets.sh" ]
}

# Vrai si le dossier courant est dans un dépôt repowarden : .repowarden.conf,
# réglage repowarden.*, ou hooks repowarden actifs. Charge sa configuration.
depot_repowarden() {
    git rev-parse --show-toplevel >/dev/null 2>&1 || return 1
    cfg_load
    i18n_init
    # shellcheck disable=SC2034 # cache de tickets_managed (tickets.sh), propre à ce dépôt
    TICKETS_MANAGED=""
    [ -n "$CFG_FILE$CFG_GIT" ] && return 0
    hooks_actifs
}

# Commit (repowarden cc, git commit) : hooks actifs, et pas sur une branche
# protégée (le commit y serait refusé ; sans terminal, cc ne crée pas de
# branche à la place de l'agent)
verifier_commit() {
    local b
    hooks_actifs || refuser garde.sans_hooks "$1"
    b="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
    if [ -n "$b" ] && protegee "$b"; then
        tickets_managed && refuser garde.commit_protegee "$1" "$b"
        refuser garde.commit_protegee_libre "$1" "$b"
    fi
}

# Vrai si les mots $@ demandent une lecture seule (aide, aperçu) : rien n'est
# commité, rien à refuser
lecture_seule() {
    local mot
    for mot in "$@"; do
        case "$mot" in -h | --help | --dry-run) return 0 ;; esac
    done
    return 1
}

# repowarden cc / commit (ou git cc), lancé depuis le dossier $dir
verifier_cc() {
    dossier_r "$dir"
    (
        cd "$REPLY" 2>/dev/null || exit 0
        depot_repowarden || exit 0
        verifier_commit "$1"
        exit 0
    ) || exit $?
}

# Branche protégée : protectedBranches (défaut main master) ou branche d'intégration
protegee() {
    cfg_r protectedBranches "main master"
    [[ " $REPLY " == *" $1 "* ]] && return 0
    cfg_r integrationBranch ""
    [ -n "$REPLY" ] && [ "$REPLY" = "$1" ]
}

# Vrai si le chemin $1 (absolu), dans le dépôt du dossier courant $2 (son
# dossier existant le plus proche), est ignoré par git : jamais versionné.
# Un fichier suivi n'est jamais ignoré (git check-ignore sans --no-index)
fichier_ignore() {
    local reste="${1#"$2"}" prefixe cdup
    reste="${reste#/}"
    [ -n "$reste" ] || return 1
    # Relatif à la racine par --show-prefix/--show-cdup : ni lien symbolique
    # (/tmp → /private/tmp) ni forme Windows (C:/… contre /c/…) à comparer
    prefixe="$(git rev-parse --show-prefix 2>/dev/null)" || return 1
    cdup="$(git rev-parse --show-cdup 2>/dev/null)" || return 1
    git -C "./$cdup" check-ignore -q -- "$prefixe$reste" 2>/dev/null
}

# Modification du fichier $1 : seulement sur une branche de travail (de ticket,
# si le dépôt suit ses tickets) ; un fichier ignoré par git l'est partout
verifier_fichier() {
    dossier_r "$1"
    # Sous Windows, jq finit le chemin lu par un CR (retiré) et le chemin peut
    # être en forme Windows (D:/…), absolu lui aussi
    local d="$REPLY" f="${1%$'\r'}"
    case "$f" in /* | [A-Za-z]:[/\\]*) ;; *) f="$cwd/$f" ;; esac
    (
        cd "$d" 2>/dev/null || exit 0
        depot_repowarden || exit 0
        # Fichiers internes de git (.git/…) : hors du travail de l'agent
        case "$(pwd -P)/" in "$(cd "$(git rev-parse --git-dir)" && pwd -P)"/*) exit 0 ;; esac
        # Fichier ignoré par git : jamais versionné, règle de branche non applicable
        ! fichier_ignore "$f" "$d" || exit 0
        if [ -f "$f" ]; then
            FICHIER_CARTE="$(cd "$(dirname "$f")" && pwd -P)/${f##*/}"
            FICHIER_CARTE="${FICHIER_CARTE#"$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"/}"
        fi
        branche="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
        [ -n "$branche" ] || refuser garde.detache "$GIT_TOPLEVEL"
        if protegee "$branche"; then
            tickets_managed && refuser garde.protegee "$branche"
            refuser garde.protegee_libre "$branche"
        fi
        if tickets_managed; then
            branch_ticket_r "$branche"
            [ -n "$REPLY" ] || refuser garde.hors_ticket "$branche"
        fi
        exit 0
    ) || exit $?
}

# Commande git (mots $@, sans « git ») lancée depuis le dossier $dir
verifier_git() {
    local mot sous="" args_git=() repertoire="$dir"
    # Options globales : -C <dossier> (cumulées), -c <clé=valeur>, autres
    while [ $# -gt 0 ]; do
        case "$1" in
            -C) shift; case "${1:-}" in /*) repertoire="$1" ;; *) repertoire="$repertoire/${1:-}" ;; esac ;;
            -c) shift ;;
            -*) ;;
            *) sous="$1"; shift; break ;;
        esac
        shift
    done
    [ -n "$sous" ] || return 0
    args_git=("$@")
    dossier_r "$repertoire"
    repertoire="$REPLY"
    (
        cd "$repertoire" 2>/dev/null || exit 0
        depot_repowarden || exit 0
        ligne="git $sous${args_git[*]+ ${args_git[*]}}"
        for mot in ${args_git[@]+"${args_git[@]}"}; do
            [ "$mot" != --no-verify ] || refuser garde.no_verify "$ligne"
        done
        case "$sous" in
            commit)
                lecture_seule ${args_git[@]+"${args_git[@]}"} && exit 0
                amend="" noedit=""
                for mot in ${args_git[@]+"${args_git[@]}"}; do
                    case "$mot" in
                        --amend) amend=1 ;;
                        --no-edit) noedit=1 ;;
                        # Options courtes groupées : -n est --no-verify (-nm, -an…)
                        -[!-]*) [[ "$mot" != *n* ]] || refuser garde.no_verify "$ligne" ;;
                    esac
                done
                hooks_actifs || refuser garde.sans_hooks "$ligne"
                [ -n "$amend" ] && [ -n "$noedit" ] && exit 0
                refuser garde.commit "$ligne"
                ;;
            push)
                for mot in ${args_git[@]+"${args_git[@]}"}; do
                    case "$mot" in
                        # Force push : réécrit l'historique distant partagé (AGENTS.md l'interdit).
                        # Options courtes groupées : -f (-uf…) ; refspec forcé : +branche
                        --force | --force-with-lease | --force-with-lease=* | --force-if-includes | +*)
                            refuser garde.force_push "$ligne" ;;
                        -[!-]*) [[ "$mot" != *f* ]] || refuser garde.force_push "$ligne" ;;
                    esac
                done
                ;;
            cc)
                lecture_seule ${args_git[@]+"${args_git[@]}"} || verifier_commit "$ligne"
                ;;
            add)
                for mot in ${args_git[@]+"${args_git[@]}"}; do
                    case "$mot" in
                        . | ./ | --all | :/) refuser garde.add_tout "$ligne" ;;
                        -[!-]*) [[ "$mot" != *A* ]] || refuser garde.add_tout "$ligne" ;;
                    esac
                done
                ;;
            checkout | switch | branch | worktree)
                tickets_managed || exit 0
                cree=""
                case "$sous" in
                    checkout) for mot in ${args_git[@]+"${args_git[@]}"}; do case "$mot" in -b | -B | --orphan) cree=1 ;; esac; done ;;
                    switch) for mot in ${args_git[@]+"${args_git[@]}"}; do case "$mot" in -c | -C | --create | --force-create | --orphan | --create=* | --force-create=*) cree=1 ;; esac; done ;;
                    worktree)
                        [ "${args_git[0]:-}" = add ] || exit 0
                        for mot in ${args_git[@]+"${args_git[@]}"}; do case "$mot" in -b | -B) cree=1 ;; esac; done
                        ;;
                    branch)
                        nom=""
                        for mot in ${args_git[@]+"${args_git[@]}"}; do
                            case "$mot" in
                                -d | -D | --delete | -m | -M | --move | -c | -C | --copy | -l | --list | -a | --all | -r | --remotes | \
                                    -v | -vv | --verbose | --show-current | --contains | --no-contains | --merged | --no-merged | \
                                    -u | --set-upstream-to | --set-upstream-to=* | --unset-upstream | --edit-description | --points-at) exit 0 ;;
                                -*) ;;
                                *) nom="$mot" ;;
                            esac
                        done
                        [ -z "$nom" ] || cree=1
                        ;;
                esac
                [ -z "$cree" ] || refuser garde.branche "$ligne"
                ;;
        esac
        exit 0
    ) || exit $?
}

# Vrai si le ticket $1 (dépôt -R $2, sinon le dépôt courant) est ouvert et
# validé : preuve qu'une écriture GitHub hors du circuit des PR a été décidée
ticket_valide() {
    local lu r=()
    [ -z "$2" ] || r=(-R "$2")
    lu="$(gh issue view "$1" ${r[@]+"${r[@]}"} --json state,labels -q '.state, .labels[].name' 2>/dev/null)" || return 2
    [ -n "$lu" ] || return 2
    [ "$(head -n 1 <<<"$lu")" = OPEN ] && grep -qxF "$VALIDE" <<<"$lu"
}

# Vrai si le texte $1 vise une étiquette de décision du mainteneur (validé,
# statut: …, à décider), même encodée dans une URL (valid%C3%A9)
etiquette_decision() {
    local t
    t="$(printf '%b' "${1//%/\\x}")"
    [[ "$t" == *"$VALIDE"* || "$t" == *"statut:"* || "$t" == *"$A_DECIDER"* ]]
}

# Vrai si l'écriture gh api (méthode $1, chemin $2, mots $3, corps lu d'un
# fichier si $4) pose, retire ou remplace les étiquettes de décision d'un
# ticket : refusée même avec un ticket validé (#496). Dans le doute, refuser
api_etiquettes_decision() {
    local m="${1:-POST}" re_etiq='/issues/[0-9]+/labels(/|\?|$)' re_ticket='/issues/[0-9]+/?(\?|$)'
    if [[ "/$2" =~ $re_etiq ]]; then
        # PUT remplace l'ensemble, DELETE sans nom le vide : validé compris
        [ "$m" != PUT ] || return 0
        [ "$m" != DELETE ] || [[ "$2" == */labels/?* ]] || return 0
        [ -z "$4" ] || return 0
        etiquette_decision "$2 $3"
    elif [[ "/$2" =~ $re_ticket ]]; then
        # PATCH du ticket : un champ labels remplace l'ensemble
        [ -n "$4" ] || [[ "$3" == *labels* ]]
    else
        return 1
    fi
}

# Commande gh (mots $@, sans « gh ») lancée depuis $dir, préfixe
# REPOWARDEN_TICKET=$ticket_gh : lectures connues permises, écritures du circuit
# par repowarden, décisions au mainteneur, tout le reste avec un ticket validé
verifier_gh() {
    local ligne="gh $*" mots="$*" pos=() depot="" methode="" champs="" corps="" approuve="" mutation="" ecriture="" hors="" rc
    while [ $# -gt 0 ]; do
        case "$1" in
            -R | --repo) shift; depot="${1:-}" ;;
            --repo=*) depot="${1#--repo=}" ;;
            -X | --method) shift; methode="${1:-}" ;;
            -X?*) methode="${1#-X}" ;;
            --method=*) methode="${1#--method=}" ;;
            --input | --input=*) champs=1 corps=1 ;;
            -f | -F | --field | --raw-field | -f?* | -F?* | --field=* | --raw-field=*) champs=1 ;;
            -a | --approve) approuve=1 ;;
            -h | --help) return 0 ;;
            -*) ;;
            *)
                pos+=("$1")
                [[ "$1" != *mutation* ]] || mutation=1
                ;;
        esac
        shift
    done
    [ -n "${pos[0]:-}" ] || return 0
    (
        cd "$dir" 2>/dev/null || exit 0
        depot_repowarden || exit 0
        # gh api : écriture si méthode autre que GET, ou champs sans -X GET
        # (POST par défaut) ; graphql : seulement une mutation
        methode="$(tr '[:lower:]' '[:upper:]' <<<"$methode")"
        if [ "${pos[1]:-}" = graphql ]; then
            ecriture="$mutation"
        elif [ -n "$methode" ]; then
            [ "$methode" = GET ] || ecriture=1
        else
            ecriture="$champs"
        fi
        case "${pos[0]} ${pos[1]:-}" in
            "issue create") refuser garde.gh_ticket_nouveau "$ligne" ;;
            "issue comment" | "issue edit") refuser garde.gh_ticket_comment "$ligne" ;;
            "pr create") refuser garde.gh_pr_create "$ligne" ;;
            "run rerun") refuser garde.gh_rerun "$ligne" ;;
            "pr ready" | "pr merge") refuser garde.gh_mainteneur "$ligne" ;;
            "pr review") [ -z "$approuve" ] || refuser garde.gh_mainteneur "$ligne"; hors=1 ;;
            "api "*)
                [ -n "$ecriture" ] || exit 0
                [[ "${pos[1]:-}" != *pending_deployments* ]] || refuser garde.gh_mainteneur "$ligne"
                ! api_etiquettes_decision "$methode" "${pos[1]:-}" "$mots" "$corps" || refuser garde.etiquette_mainteneur "$ligne"
                hors=1
                ;;
            # Lectures connues et description de la PR : permises ; tout le
            # reste (sous-commande oubliée ou future comprise) demande un ticket
            "auth status" | "pr edit" | "search "* | "browse "* | "status "* | "version "* | "help "*) exit 0 ;;
            *)
                case "${pos[1]:-}" in view | list | status | checks | diff | watch) exit 0 ;; esac
                hors=1
                ;;
        esac
        [ -n "$hors" ] || exit 0
        [ -n "$ticket_gh" ] || refuser garde.gh_sans_ticket "$ligne" "$ligne"
        [[ "$ticket_gh" =~ ^[0-9]+$ ]] || refuser garde.gh_ticket_illisible "$ligne" "$ticket_gh"
        rc=0
        ticket_valide "$ticket_gh" "$depot" || rc=$?
        [ "$rc" -ne 2 ] || refuser garde.gh_ticket_illisible "$ligne" "$ticket_gh"
        [ "$rc" -eq 0 ] || refuser garde.gh_ticket_non_valide "$ligne" "$ticket_gh" "$VALIDE"
        exit 0
    ) || exit $?
}

# repowarden ticket label <n> <label> [--remove] (mots $@ après « repowarden »),
# lancé depuis $dir : poser ou retirer « validé » ou un statut valide le ticket,
# décision du mainteneur refusée même avec REPOWARDEN_TICKET (incident #477)
verifier_ticket_label() {
    local ligne="repowarden $*" mot decision=""
    case "$1" in
        ticket) [ "${2:-}" = label ] || return 0; shift 2 ;;
        *) shift ;;
    esac
    [ $# -ge 2 ] || return 0
    lecture_seule "$@" && return 0
    # Mots après le numéro : une étiquette entre guillemets y est découpée
    # (« statut: en cours » → statut:), dans le doute refuser
    shift
    for mot in "$@"; do
        etiquette_decision "$mot" && decision=1
    done
    # Étiquette de décision en plusieurs mots (« à décider »), découpée par read -a
    etiquette_decision "$*" && decision=1
    [ -n "$decision" ] || return 0
    dossier_r "$dir"
    (
        cd "$REPLY" 2>/dev/null || exit 0
        depot_repowarden || exit 0
        refuser garde.ticket_mainteneur "$ligne"
    ) || exit $?
}

# repowarden ticket nouveau/new (mots $@), depuis $dir : créer un ticket est
# une décision du mainteneur, sauf agentsTickets ; --help reste permis (#496)
verifier_ticket_nouveau() {
    local ligne="repowarden $*"
    [ "${1:-}" = ticket ] || return 0
    case "${2:-}" in nouveau | new) ;; *) return 0 ;; esac
    lecture_seule "$@" && return 0
    dossier_r "$dir"
    (
        cd "$REPLY" 2>/dev/null || exit 0
        depot_repowarden || exit 0
        cfg_r agentsTickets false
        [ "$REPLY" != true ] || exit 0
        refuser garde.ticket_nouveau "$ligne"
    ) || exit $?
}

# Découpe $1 en une commande par ligne (REPLY) : « ; », « | », « && », « || » et
# le « & » séparateur coupent hors guillemets simples et doubles (antislash
# compris) ; seul le « & » d'une vraie redirection (N>&M, >&2, >&-, &>, &>>, non
# échappée) reste dans la commande, citée entière. Dans le doute couper : au pire
# une commande de trop, jamais une masquée (true \>&git push -f lance git).
# Entre guillemets le retour à la ligne devient une espace : le contenu exact
# d'une chaîne n'importe pas pour juger la commande.
decouper_lignes() {
    local s="$1" out="" c q="" i j prec avant nl=$'\n'
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        if [ -n "$q" ]; then
            if [ "$c" = "$nl" ]; then
                out="$out "
                continue
            fi
            out="$out$c"
            if [ "$c" = "$q" ]; then
                q=""
            elif [ "$c" = "\\" ] && [ "$q" = '"' ]; then
                i=$((i + 1))
                out="$out${s:i:1}"
            fi
            continue
        fi
        case "$c" in
            "'" | '"')
                q="$c"
                out="$out$c"
                continue
                ;;
            "\\")
                out="$out$c"
                i=$((i + 1))
                out="$out${s:i:1}"
                continue
                ;;
            ";" | "|")
                out="$out$nl"
                continue
                ;;
        esac
        if [ "$c" != "&" ]; then
            out="$out$c"
            continue
        fi
        prec="" avant=""
        [ "$i" -lt 1 ] || prec="${s:i-1:1}"
        [ "$i" -lt 2 ] || avant="${s:i-2:1}"
        # &> et &>> : le « & » lui-même non échappé
        if [ "${s:i+1:1}" = ">" ] && [ "$prec" != "\\" ]; then
            out="$out&"
            continue
        fi
        # >&N, <&N, >&- : « > » ou « < » non échappé avant, un descripteur ou
        # « - » après, puis une fin de mot
        if { [ "$prec" = ">" ] || [ "$prec" = "<" ]; } && [ "$avant" != "\\" ]; then
            j=$((i + 1))
            if [ "${s:j:1}" = "-" ]; then
                j=$((j + 1))
            else
                while [[ "${s:j:1}" == [0-9] ]]; do j=$((j + 1)); done
            fi
            if [ "$j" -gt $((i + 1)) ]; then
                case "${s:j:1}" in
                    "" | " " | $'\t' | "$nl" | "&" | ";" | "|" | ")")
                        out="$out&"
                        continue
                        ;;
                esac
            fi
        fi
        out="$out$nl"
    done
    REPLY="$out"
}

# Découpe $1 en mots (MOTS) en respectant guillemets simples et doubles et
# antislash, sans sous-processus ; guillemet non fermé : MOTS vide, code 1.
decouper_mots() {
    local s="$1" mot="" q="" c i n
    MOTS=()
    n=${#s}
    for ((i = 0; i < n; i++)); do
        c="${s:i:1}"
        if [ -n "$q" ]; then
            if [ "$c" = "$q" ]; then
                q=""
            elif [ "$c" = "\\" ] && [ "$q" = '"' ]; then
                case "${s:i+1:1}" in
                    '"' | "\\" | '$' | '`') i=$((i + 1)); mot="$mot${s:i:1}" ;;
                    *) mot="$mot\\" ;;
                esac
            else
                mot="$mot$c"
            fi
            continue
        fi
        case "$c" in
            "'" | '"') q="$c" ;;
            "\\")
                i=$((i + 1))
                mot="$mot${s:i:1}"
                ;;
            " " | $'\t')
                [ -z "$mot" ] || { MOTS+=("$mot"); mot=""; }
                ;;
            *) mot="$mot$c" ;;
        esac
    done
    if [ -n "$q" ]; then
        MOTS=()
        return 1
    fi
    [ -z "$mot" ] || MOTS+=("$mot")
}

# Ligne de commande shell : chaque commande (« ; », « | », « && », « || » et le
# « & » séparateur, hors guillemets), « cd » suivi, variables d'environnement en
# tête ignorées (sauf REPOWARDEN_TICKET, le ticket d'une écriture gh hors du
# circuit des PR)
verifier_shell() {
    local commande="$1" segment m cmd_cc lignes ticket_gh
    if [ -n "$workdir" ]; then
        # Absolu : /…, ou C:/… et C:\… (Windows, #498)
        case "$workdir" in /* | [A-Za-z]:[/\\]*) dir="$workdir" ;; *) dir="$cwd/$workdir" ;; esac
    else
        dir="$cwd"
    fi
    # Une commande par ligne, en un seul parcours caractère par caractère qui
    # respecte les guillemets (pas de <( … ) : bash 3.2 le lit mal).
    decouper_lignes "$commande"
    lignes="$REPLY"
    # Plusieurs commandes : un refus vaut pour toute la ligne (dit à l'agent)
    [ "$(grep -c '[^[:space:]]' <<<"$lignes")" -le 1 ] || LIGNE_MULTIPLE=1
    while IFS= read -r segment; do
        # Guillemet non fermé : commande illisible, refusée dans un dépôt
        # repowarden (dans le doute, refuser) ; ailleurs, tout est permis
        if ! decouper_mots "$segment"; then
            dossier_r "$dir"
            (
                cd "$REPLY" 2>/dev/null || exit 0
                depot_repowarden || exit 0
                refuser garde.commande_illisible "$segment"
            ) || exit $?
            continue
        fi
        set -- ${MOTS[@]+"${MOTS[@]}"}
        ticket_gh=""
        while [ $# -gt 0 ]; do
            case "$1" in
                REPOWARDEN_TICKET=*) m="${1#REPOWARDEN_TICKET=}"; ticket_gh="${m//[\"\']/}"; shift ;;
                [A-Za-z_]*=* | '(' | '{' | '!' | command | exec | env | sudo | time | nohup) shift ;;
                *) break ;;
            esac
        done
        [ $# -gt 0 ] || continue
        # Commande : dernier élément du chemin (/ ou \), sans .exe/.cmd/.bat
        m="${1//[\"\']/}"
        m="${m##*/}"
        m="${m##*\\}"
        case "$m" in
            *.exe | *.EXE | *.cmd | *.CMD | *.bat | *.BAT) m="${m%.*}" ;;
        esac
        case "$m" in
            cd)
                case "${2:-}" in
                    "" | \~) dir="$HOME" ;;
                    /*) dir="${2//[\"\']/}" ;;
                    \~/*) dir="$HOME/${2#\~/}" ;;
                    *) dir="$dir/${2//[\"\']/}" ;;
                esac
                ;;
            git)
                shift
                verifier_git "${@//[\"\']/}"
                ;;
            gh)
                shift
                verifier_gh "${@//[\"\']/}"
                ;;
            repowarden)
                shift
                verifier_ticket_nouveau "${@//[\"\']/}"
                set -- repowarden "$@"
                case "${2//[\"\']/}" in
                    cc | commit)
                        cmd_cc="repowarden ${2//[\"\']/}"
                        shift 2
                        lecture_seule "${@//[\"\']/}" || verifier_cc "$cmd_cc"
                        ;;
                    ticket | ticket-label)
                        shift
                        verifier_ticket_label "${@//[\"\']/}"
                        ;;
                esac
                ;;
        esac
    done <<<"$lignes"
}

case "$outil" in
    Edit | Write | MultiEdit | NotebookEdit | edit | write | multiedit)
        # path : outils edit et write d'opencode 2.x
        chemin="$(jq -r '.file_path // .filePath // .notebook_path // .path // empty' <<<"$args" 2>/dev/null)"
        [ -z "$chemin" ] || verifier_fichier "$chemin"
        ;;
    apply_patch)
        while IFS= read -r chemin; do
            [ -z "$chemin" ] || verifier_fichier "$chemin"
        done < <(jq -r '.patchText // empty' <<<"$args" 2>/dev/null |
            sed -nE -e 's/^\*\*\* (Add|Update|Delete) File: //p' -e 's/^\*\*\* Move to: //p')
        ;;
    # shell : nom de l'outil bash dans opencode 2.x
    Bash | bash | shell)
        verifier_shell "$(jq -r '.command // empty' <<<"$args" 2>/dev/null)"
        ;;
esac
exit 0
