#!/usr/bin/env bash
# Gérer les labels d'un ticket GitHub
#   repowarden ticket label <n> <label> [--remove]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"
# shellcheck source=../hooks/lib/i18n.sh
source "$ROOT/hooks/lib/i18n.sh"

aide() {
    _tr help.ticket
    printf '%b\n' "$_T"
}

case "${1:-}" in
    -h | --help) aide; exit 0 ;;
esac

[ $# -ge 2 ] || { aide >&2; exit 1; }
command -v gh >/dev/null || { err_t bot.no_gh; exit 1; }

n="${1}"
label="${2}"
remove=false

shift 2
while [ $# -gt 0 ]; do
    case "$1" in
        --remove) remove=true ;;
        *) err_t install.unknown_arg "$1"; exit 1 ;;
    esac
    shift
done

if [ "$remove" = true ]; then
    step_t tk.label.removing "$label" "$n"
    gh issue edit "$n" --remove-label "$label"
    ok_t tk.label.removed "$label" "$n"
else
    step_t tk.label.adding "$label" "$n"
    gh issue edit "$n" --add-label "$label"
    ok_t tk.label.added "$label" "$n"
fi