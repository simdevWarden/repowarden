#!/usr/bin/env bash
# Branche le garde-fou repowarden (repowarden garde) dans les agents IA :
#   repowarden agents init    [--claude] [--opencode] [--projet | --global]
#   repowarden agents retirer [--claude] [--opencode] [--projet | --global]
#     Claude Code  hook PreToolUse dans .claude/settings.json
#     opencode     plugins .opencode/plugins/repowarden-garde.js (opencode 1.x)
#                  et repowarden-garde-v2.js (opencode 2.x)
# Sans --claude ni --opencode : les deux. --projet (défaut) : fichiers du dépôt,
# à versionner ; --global : configuration de l'utilisateur, là où chaque outil
# la lit (CLAUDE_CONFIG_DIR ; OPENCODE_CONFIG_DIR, sinon XDG_CONFIG_HOME).
# Relançable : fichiers existants complétés ; un garde-fou posé par une version
# antérieure de repowarden est mis à jour, un fichier personnel jamais écrasé ;
# retirer n'enlève que ce qu'init a écrit.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"
# shellcheck source=../hooks/lib/agents.sh
source "$ROOT/hooks/lib/agents.sh"

aide() { _tr help.agents; printf '%b\n' "$_T"; }

COMMANDE_CLAUDE="$AGENTS_COMMANDE_CLAUDE"
MATCHER_CLAUDE="$AGENTS_MATCHER_CLAUDE"

action=""
case "${1:-}" in
    init | retirer) action="$1"; shift ;;
    remove) action=retirer; shift ;;
    "" | -h | --help) aide; exit 0 ;;
    *) err_t install.unknown_arg "$1"; aide >&2; exit 1 ;;
esac

claude="" opencode="" portee=projet
while [ $# -gt 0 ]; do
    case "$1" in
        --claude) claude=1 ;;
        --opencode) opencode=1 ;;
        --projet | --project) portee=projet ;;
        --global) portee=global ;;
        -h | --help) aide; exit 0 ;;
        *) err_t install.unknown_arg "$1"; aide >&2; exit 1 ;;
    esac
    shift
done
[ -n "$claude$opencode" ] || claude=1 opencode=1

if [ "$portee" = projet ]; then
    [ -n "$GIT_TOPLEVEL" ] || { err_t install.not_repo; exit 1; }
    base="$GIT_TOPLEVEL"
    fichier_claude="$base/.claude/settings.json"
    dossier_opencode="$base/.opencode/plugins"
else
    # Réglages utilisateur de Claude Code : $CLAUDE_CONFIG_DIR s'il est défini
    # (code.claude.com/docs/en/settings) ; plugins globaux d'opencode :
    # $OPENCODE_CONFIG_DIR, sinon $XDG_CONFIG_HOME/opencode (opencode.ai/docs/config)
    fichier_claude="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
    dossier_opencode="${OPENCODE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}/plugins"
fi

ecrits=()

# Hook PreToolUse de Claude Code : ajouté au settings.json (créé au besoin),
# rien si une commande « repowarden garde » y est déjà ; d'une ancienne forme,
# remplacé (les autres hooks restent)
init_claude() {
    local f="$fichier_claude" entree tmp
    has jq || { err_t agents.no_jq "$f"; return 1; }
    entree="$(jq -n --arg m "$MATCHER_CLAUDE" --arg c "$COMMANDE_CLAUDE" \
        '{matcher: $m, hooks: [{type: "command", command: $c}]}')"
    if [ -f "$f" ]; then
        jq -e . "$f" >/dev/null 2>&1 || { err_t agents.bad_json "Claude Code" "$f"; return 1; }
        if agents_claude_perime "$f"; then
            tmp="$(mktemp)"
            jq --argjson e "$entree" 'def rw: (.command // "") | startswith("repowarden garde");
                .hooks.PreToolUse = ([.hooks.PreToolUse[]
                    | if any(.hooks[]?; rw) then (.hooks |= map(select(rw | not))) | select(.hooks | length > 0) else . end]
                    + [$e])' "$f" >"$tmp"
            cat "$tmp" >"$f"
            rm -f "$tmp"
            ecrits+=("$f")
            ok_t agents.updated "Claude Code" "$f"
            return 0
        fi
        if jq -e '[.hooks.PreToolUse[]?.hooks[]?.command // empty | select(test("repowarden garde"))] | length > 0' "$f" >/dev/null; then
            ok_t agents.present "Claude Code" "$f"
            return 0
        fi
        tmp="$(mktemp)"
        jq --argjson e "$entree" '.hooks.PreToolUse = ((.hooks.PreToolUse // []) + [$e])' "$f" >"$tmp"
        cat "$tmp" >"$f"
        rm -f "$tmp"
    else
        mkdir -p "$(dirname "$f")"
        jq -n --argjson e "$entree" '{hooks: {PreToolUse: [$e]}}' >"$f"
    fi
    ecrits+=("$f")
    ok_t agents.added "Claude Code" "$f"
}

# Plugins opencode (1.x et 2.x) : copie du modèle ; celui d'une version
# antérieure de repowarden est remplacé, un fichier personnel gardé et signalé
init_opencode() {
    local p f modele
    for p in $AGENTS_PLUGINS_OPENCODE; do
        f="$dossier_opencode/$p" modele="$AGENTS_MODELES/$p"
        if [ ! -f "$f" ]; then
            mkdir -p "$dossier_opencode"
            cp "$modele" "$f"
            ecrits+=("$f")
            ok_t agents.added opencode "$f"
        elif cmp -s "$f" "$modele"; then
            ok_t agents.present opencode "$f"
        elif agents_plugin_repowarden "$f"; then
            cp "$modele" "$f"
            ecrits+=("$f")
            ok_t agents.updated opencode "$f"
        else
            attention_t agents.kept opencode "$f" "$modele"
        fi
    done
}

# Hook PreToolUse : seules les commandes « repowarden garde » retirées ; une
# entrée vidée disparaît, et le fichier s'il ne reste plus rien
retirer_claude() {
    local f="$fichier_claude" tmp
    if [ ! -f "$f" ] || ! grep -q "repowarden garde" "$f"; then
        ok_t agents.absent "Claude Code" "$f"
        return 0
    fi
    has jq || { err_t agents.no_jq "$f"; return 1; }
    jq -e . "$f" >/dev/null 2>&1 || { err_t agents.bad_json "Claude Code" "$f"; return 1; }
    tmp="$(mktemp)"
    jq '(.hooks.PreToolUse // []) as $p
        | .hooks.PreToolUse = [$p[] | .hooks = [(.hooks // [])[] | select((.command // "") | test("repowarden garde") | not)]
            | select(.hooks | length > 0)]
        | if (.hooks.PreToolUse | length) == 0 then del(.hooks.PreToolUse) else . end
        | if (.hooks | length) == 0 then del(.hooks) else . end' "$f" >"$tmp"
    if [ "$(jq -c . "$tmp")" = "{}" ]; then
        rm -f "$f"
    else
        cat "$tmp" >"$f"
    fi
    rm -f "$tmp"
    ok_t agents.removed "Claude Code" "$f"
}

# Plugins opencode : chacun supprimé s'il est celui du modèle ; modifié, gardé
# et signalé
retirer_opencode() {
    local p f
    for p in $AGENTS_PLUGINS_OPENCODE; do
        f="$dossier_opencode/$p"
        if [ ! -f "$f" ]; then
            ok_t agents.absent opencode "$f"
        elif cmp -s "$f" "$AGENTS_MODELES/$p"; then
            rm -f "$f"
            ok_t agents.removed opencode "$f"
        else
            attention_t agents.kept_remove opencode "$f"
        fi
    done
}

statut=0
if [ "$action" = retirer ]; then
    [ -z "$claude" ] || retirer_claude || statut=1
    [ -z "$opencode" ] || retirer_opencode || statut=1
    exit "$statut"
fi
[ -z "$claude" ] || init_claude || statut=1
[ -z "$opencode" ] || init_opencode || statut=1

has repowarden || attention_t agents.no_repowarden
# Hooks repowarden inactifs : le garde-fou refusera les commits, autant le
# dire maintenant (dossier de hooks repowarden : commit-msg et lib/common.sh)
if [ "$portee" = projet ]; then
    hp="$(git config --get core.hooksPath 2>/dev/null || true)"
    # Absolu : /…, ou C:/… et C:\… (git pour Windows)
    case "$hp" in "" | /* | [A-Za-z]:[/\\]* | \~/*) ;; *) hp="$base/$hp" ;; esac
    lieu="$base" commande="repowarden install"
else
    hp="$(git config --global --get core.hooksPath 2>/dev/null || true)"
    lieu="(--global)" commande="repowarden install --global"
fi
case "$hp" in \~/*) hp="$HOME/${hp#\~/}" ;; esac
if [ -z "$hp" ] || [ ! -f "$hp/commit-msg" ] || [ ! -f "$hp/lib/common.sh" ]; then
    attention_t agents.sans_hooks "$lieu" "$commande"
fi
if [ "$portee" = projet ] && [ ${#ecrits[@]} -gt 0 ]; then
    info_t agents.versionner "${ecrits[*]#"$base/"}"
fi
exit "$statut"
