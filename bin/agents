#!/usr/bin/env bash
# Branche le garde-fou repowarden (repowarden garde) dans les agents IA :
#   repowarden agents init [--claude] [--opencode] [--projet | --global]
#     Claude Code  hook PreToolUse dans .claude/settings.json
#     opencode     plugin .opencode/plugins/repowarden-garde.js
# Sans --claude ni --opencode : les deux. --projet (défaut) : fichiers du dépôt,
# à versionner ; --global : configuration de l'utilisateur. Relançable :
# fichiers existants complétés, jamais écrasés.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

aide() { _tr help.agents; printf '%b\n' "$_T"; }

MODELE_OPENCODE="$ROOT/hooks/agents/repowarden-garde.js"
COMMANDE_CLAUDE="repowarden garde --format claude"
MATCHER_CLAUDE="Edit|Write|MultiEdit|NotebookEdit|Bash"

case "${1:-}" in
    init) shift ;;
    "" | -h | --help) aide; exit 0 ;;
    *) err_t install.unknown_arg "$1"; aide >&2; exit 1 ;;
esac

claude="" opencode="" portee=projet
while [ $# -gt 0 ]; do
    case "$1" in
        --claude) claude=1 ;;
        --opencode) opencode=1 ;;
        --projet | --project) portee=projet ;;
        --global) portee=global ;;
        -h | --help) aide; exit 0 ;;
        *) err_t install.unknown_arg "$1"; aide >&2; exit 1 ;;
    esac
    shift
done
[ -n "$claude$opencode" ] || claude=1 opencode=1

if [ "$portee" = projet ]; then
    [ -n "$GIT_TOPLEVEL" ] || { err_t install.not_repo; exit 1; }
    base="$GIT_TOPLEVEL"
    fichier_claude="$base/.claude/settings.json"
    fichier_opencode="$base/.opencode/plugins/repowarden-garde.js"
else
    fichier_claude="$HOME/.claude/settings.json"
    fichier_opencode="$HOME/.config/opencode/plugins/repowarden-garde.js"
fi

ecrits=()

# Hook PreToolUse de Claude Code : ajouté au settings.json (créé au besoin),
# rien si une commande « repowarden garde » y est déjà
init_claude() {
    local f="$fichier_claude" entree tmp
    has jq || { err_t agents.no_jq "$f"; return 1; }
    entree="$(jq -n --arg m "$MATCHER_CLAUDE" --arg c "$COMMANDE_CLAUDE" \
        '{matcher: $m, hooks: [{type: "command", command: $c}]}')"
    if [ -f "$f" ]; then
        jq -e . "$f" >/dev/null 2>&1 || { err_t agents.bad_json "Claude Code" "$f"; return 1; }
        if jq -e '[.hooks.PreToolUse[]?.hooks[]?.command // empty | select(test("repowarden garde"))] | length > 0' "$f" >/dev/null; then
            ok_t agents.present "Claude Code" "$f"
            return 0
        fi
        tmp="$(mktemp)"
        jq --argjson e "$entree" '.hooks.PreToolUse = ((.hooks.PreToolUse // []) + [$e])' "$f" >"$tmp"
        cat "$tmp" >"$f"
        rm -f "$tmp"
    else
        mkdir -p "$(dirname "$f")"
        jq -n --argjson e "$entree" '{hooks: {PreToolUse: [$e]}}' >"$f"
    fi
    ecrits+=("$f")
    ok_t agents.added "Claude Code" "$f"
}

# Plugin opencode : copie du modèle ; un fichier différent est gardé et signalé
init_opencode() {
    local f="$fichier_opencode"
    if [ -f "$f" ]; then
        if cmp -s "$f" "$MODELE_OPENCODE"; then
            ok_t agents.present opencode "$f"
        else
            attention_t agents.kept opencode "$f" "$MODELE_OPENCODE"
        fi
        return 0
    fi
    mkdir -p "$(dirname "$f")"
    cp "$MODELE_OPENCODE" "$f"
    ecrits+=("$f")
    ok_t agents.added opencode "$f"
}

statut=0
[ -z "$claude" ] || init_claude || statut=1
[ -z "$opencode" ] || init_opencode || statut=1

has repowarden || attention_t agents.no_repowarden
if [ "$portee" = projet ] && [ ${#ecrits[@]} -gt 0 ]; then
    info_t agents.versionner "${ecrits[*]#"$base/"}"
fi
exit "$statut"
