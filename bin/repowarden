#!/usr/bin/env bash
# Point d'entrée unique de repowarden (paquet npm, ou clone du dépôt) :
#   repowarden                                     état du poste et étape suivante
#   repowarden statut                              (idem)
#   repowarden install [--global] [--lang fr|en]   active les hooks (install.sh)
#   repowarden bots                                bots du dépôt GitHub (CI, releases, tickets…)
#   repowarden uninstall [--global] [--purge]      les retire (avant npm uninstall -g)
#   repowarden cc                                  assistant de commit
#   repowarden code-mort                           nouveau code mort de la branche
#   repowarden ticket <n>                         branche du ticket (créée, liée, si besoin)
#   repowarden ticket nouveau "<titre>"           nouveau ticket
#   repowarden ticket comment <n> "<texte>"       commentaire sur un ticket
#   repowarden ticket label <n> <label> [--remove]  gère les labels d'un ticket
#   repowarden pr label <n> <label> [--remove]     gère les labels d'une PR
#   repowarden pr checks <n>                      vérifie les checks d'une PR
#   repowarden run rerun <id|--failed|--workflow> relance un workflow
#   repowarden run list [--workflow <nom>]        liste les runs récents
#   repowarden tickets init                        suivi des tickets (GitHub)
#   repowarden proteger [options]                  protection des branches (GitHub)
#   repowarden migrer [--pr] [--hooks]             passage de repogarde à repowarden
#   repowarden npm-publication                     publication npm automatique
#   repowarden app init                            GitHub App des workflows (une fois)
#   repowarden bot [init|rapport]                  bot d'organisation (dépôt de pilotage)
#   repowarden --version
set -euo pipefail

# Dossier réel du paquet : npm appelle ce script via un lien symbolique
# (node_modules/.bin, préfixe global) ; readlink -f absent de macOS
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd -P)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/.." && pwd -P)"
# shellcheck source=../hooks/lib/ui.sh
source "$ROOT/hooks/lib/ui.sh"
# shellcheck source=../hooks/lib/i18n.sh
source "$ROOT/hooks/lib/i18n.sh"

# Clé d'aide d'une commande, alias compris ; vide si la commande est inconnue.
help_key_r() {
    case "$1" in
        install) REPLY=help.install ;;
        uninstall) REPLY=help.uninstall ;;
        bots) REPLY=help.bots ;;
        bot) REPLY=help.bot ;;
        cc | commit) REPLY=help.cc ;;
        code-mort | deadcode) REPLY=help.code-mort ;;
        ticket) REPLY=help.ticket ;;
        tickets) REPLY=help.tickets ;;
        pr) REPLY=help.pr ;;
        run) REPLY=help.run ;;
        app) REPLY=help.app ;;
        migrer | migrate) REPLY=help.migrer ;;
        proteger | protect) REPLY=help.proteger ;;
        npm-publication | npm-publish) REPLY=help.npm-publication ;;
        "" | statut | status) REPLY=help.statut ;;
        *) REPLY="" ;;
    esac
}

aide() { _tr help.main; printf '%b\n' "$_T" >&2; }

commande="${1:-}"
cmd="$commande"
[ $# -eq 0 ] || shift

# Une seule interception : le premier argument de la sous-commande, testé
# avant l'exécution (code 0, rien n'est fait). Seul ce premier argument
# compte : cc -m "--help" reste un message. pr et run gardent leurs
# sous-commandes (label, checks, rerun, list), dispatchées plus bas.
case "${1:-}" in
    -h | --help | help)
        help_key_r "$cmd"
        if [ -n "$REPLY" ]; then
            _tr "$REPLY"
            printf '%b\n' "$_T"
            exit 0
        fi
        err_t install.unknown_arg "$cmd"
        aide
        exit 1
        ;;
esac

case "$cmd" in
    install)
        # npx : paquet dans un cache temporaire, effaçable à tout moment ;
        # des hooks globaux y pointeraient vers un dossier disparu
        if [[ " $* " == *" --global "* && "$ROOT" == */_npx/* ]]; then
            err_t npm.npx_global
            exit 1
        fi
        exec bash "$ROOT/install.sh" "$@"
        ;;
    uninstall) exec bash "$ROOT/install.sh" --uninstall "$@" ;;
    cc | commit) exec bash "$ROOT/bin/commit" "$@" ;;
    code-mort | deadcode) exec bash "$ROOT/bin/code-mort" "$@" ;;
    tickets) exec bash "$ROOT/bin/tickets" "$@" ;;
    ticket) exec bash "$ROOT/bin/ticket" "$@" ;;
    ticket-comment) exec bash "$ROOT/bin/ticket-comment" "$@" ;;
    ticket-label) exec bash "$ROOT/bin/ticket-label" "$@" ;;
    pr)
        if [ $# -ge 1 ]; then
            case "$1" in
                label) exec bash "$ROOT/bin/pr-label" "${@:2}" ;;
                checks) exec bash "$ROOT/bin/pr-checks" "${@:2}" ;;
                *) err_t install.unknown_arg "$1"; _tr help.pr; printf '%b\n' "$_T" >&2; exit 1 ;;
            esac
        else
            _tr help.pr; printf '%b\n' "$_T"; exit 0
        fi
        ;;
    run)
        if [ $# -ge 1 ]; then
            case "$1" in
                rerun) exec bash "$ROOT/bin/run-rerun" "${@:2}" ;;
                list) exec bash "$ROOT/bin/run-list" "${@:2}" ;;
                *) err_t install.unknown_arg "$1"; _tr help.run; printf '%b\n' "$_T" >&2; exit 1 ;;
            esac
        else
            _tr help.run; printf '%b\n' "$_T"; exit 0
        fi
        ;;
    pr-label) exec bash "$ROOT/bin/pr-label" "$@" ;;
    run-rerun) exec bash "$ROOT/bin/run-rerun" "$@" ;;
    run-list) exec bash "$ROOT/bin/run-list" "$@" ;;
    pr-checks) exec bash "$ROOT/bin/pr-checks" "$@" ;;
    proteger | protect) exec bash "$ROOT/bin/proteger" "$@" ;;
    migrer | migrate) exec bash "$ROOT/bin/migrer" "$@" ;;
    npm-publication | npm-publish) exec bash "$ROOT/bin/npm-publication" "$@" ;;
    app) exec bash "$ROOT/bin/app" "$@" ;;
    bots) exec bash "$ROOT/bin/bots" "$@" ;;
    bot) exec bash "$ROOT/bin/bot" "$@" ;;
    -v | --version | version)
        repowarden_version_r "$ROOT"
        echo "$REPLY"
        ;;
    "" | statut | status) exec bash "$ROOT/bin/statut" "$@" ;;
    -h | --help | help)
        _tr help.main
        printf '%b\n' "$_T"
        ;;
    *)
        err_t install.unknown_arg "$cmd"
        aide
        exit 1
        ;;
esac
