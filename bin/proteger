#!/usr/bin/env bash
# Protège le dépôt GitHub courant d'après .repowarden.conf (relançable sans risque) :
#   - branches protectedBranches : PR obligatoire, vérifications exigées à jour,
#     ni suppression ni push forcé (ruleset « repowarden ») ;
#   - merges : squash ; avec integrationBranch (flux develop), merge commit sur
#     main et branche par défaut develop ; titre de PR = message du commit ;
#   - tags v* : créés, déplacés ou supprimés uniquement par les workflows ;
#   - GitHub Actions autorisé à créer des PR (releases automatiques) ;
#   - validation humaine (optionnelle) : approbations obligatoires, revue des
#     CODEOWNERS, environnement de déploiement approuvé par des personnes ;
#     livraison approuvée (deliveryApproval deployment ou review, défaut) ou
#     automatique (auto : vérifications exigées gardées).
#
#   bin/proteger [--repo propriétaire/nom] [--checks "repowarden,tests (ubuntu-latest)"] [--relecteurs N]
#                [--codeowners] [--environnement NOM] [--approbateurs "login …"]
#                [--sans-tags] [--dry-run] [--verifier]
# --sans-tags : dépôt qui déplace lui-même un tag (tag majeur flottant v2…).
# --verifier : compare les règles en ligne à celles attendues, sans rien modifier
# (après une mise à jour de repowarden ou de .repowarden.conf).
# Réglages équivalents dans .repowarden.conf (requiredReviews, codeOwnerReview,
# unattributedApproval, deliveryApproval, environment, environmentReviewers). Demande un gh connecté, admin du dépôt.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

cfg_r requiredReviews 0
REVIEWS="$REPLY"
cfg_r codeOwnerReview false
CODEOWNERS="$REPLY"
# Approbation supplémentaire des changements non attribués : GitHub l'active
# d'office si elle n'est pas posée, et une PR ouverte par une application
# (jeton des Actions : PR de livraison, PR brouillon des tickets) attend alors
# un humain, même sans approbation exigée. Posée explicitement, false par défaut.
cfg_r unattributedApproval false
UNATTRIBUTED="$REPLY"
cfg_r environment ""
ENVIRONMENT="$REPLY"
cfg_r environmentReviewers ""
APPROVERS="$REPLY"
REPO=""
CHECKS="repowarden"
DRY_RUN=""
VERIFY=""
CHECKS_SET=""
NO_TAGS=""
while [ $# -gt 0 ]; do
    case "$1" in
        --repo) shift; REPO="${1:?--repo attend propriétaire/nom}" ;;
        --checks) shift; CHECKS="${1:?--checks attend une liste}"; CHECKS_SET=1 ;;
        --relecteurs) shift; REVIEWS="${1:?--relecteurs attend un nombre}" ;;
        --codeowners) CODEOWNERS=true ;;
        --environnement) shift; ENVIRONMENT="${1:?--environnement attend un nom}" ;;
        --approbateurs) shift; APPROVERS="${1:?--approbateurs attend des logins}" ;;
        --sans-tags) NO_TAGS=1 ;;
        --dry-run) DRY_RUN=1 ;;
        --verifier) VERIFY=1 ;;
        -h | --help) _tr help.proteger; printf '%b\n' "$_T"; exit 0 ;;
        *) err_t install.unknown_arg "$1"; exit 1 ;;
    esac
    shift
done
[ -n "$REPO" ] || REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
[[ "$REVIEWS" =~ ^[0-9]$ ]] || { err_t ci.proteger.reviews_invalid; exit 1; }
[[ "$CODEOWNERS" =~ ^(true|false)$ ]] || { err_t ci.proteger.codeowners_invalid; exit 1; }
[[ "$UNATTRIBUTED" =~ ^(true|false)$ ]] || { err_t ci.proteger.unattributed_invalid; exit 1; }
# Dev solo (une seule personne avec l'écriture) : aucune règle n'exige une
# autre personne, qui n'existe pas. Nombre inconnu (appel en échec) : pas solo.
solo=false
[ "$(gh api "repos/$REPO/collaborators?per_page=100" \
    --jq '[.[] | select(.permissions.push)] | length' 2>/dev/null)" = 1 ] && solo=true
# Avec relecture : le dernier à pousser ne peut pas approuver son propre push
last_push=false
[ "$REVIEWS" = 0 ] || [ "$solo" = true ] || last_push=true

cfg_r protectedBranches "main master"
protected="$REPLY"
cfg_r integrationBranch ""
integration="$REPLY"

# Branches protégées existant sur GitHub (main ou master selon le dépôt)
existing=""
for b in $protected; do
    # Nom renvoyé comparé : GitHub redirige une branche renommée (master → main)
    [ "$(gh api "repos/$REPO/branches/$b" --jq .name 2>/dev/null)" = "$b" ] && existing="$existing $b"
done
[ -n "$existing" ] || { err_t ci.proteger.no_branch "$protected" "$REPO"; exit 1; }
# Branche d'intégration absente : arrêt avant toute modification (GitHub
# refuserait une branche par défaut inexistante, réglages posés à moitié)
if [ -n "$integration" ] &&
    [ "$(gh api "repos/$REPO/branches/$integration" --jq .name 2>/dev/null)" != "$integration" ]; then
    principale=main
    for b in $existing; do [ "$b" = "$integration" ] || { principale="$b"; break; }; done
    err_t ci.proteger.no_integration "$integration" "$REPO"
    dim_t ci.proteger.no_integration_hint "$principale" "$integration"
    exit 1
fi

# Vérifications séparées par des virgules : un nom de job peut contenir des
# espaces (« tests (ubuntu-latest) »)
contexts=""
IFS=, read -ra checks <<<"$CHECKS"
for c in "${checks[@]}"; do
    c="${c#"${c%%[![:space:]]*}"}"
    c="${c%"${c##*[![:space:]]}"}"
    [ -n "$c" ] && contexts="$contexts {\"context\": \"$c\", \"integration_id\": 15368},"
done
contexts="${contexts%,}"

refs_json() { # branches → "refs/heads/a", "refs/heads/b"
    local b out=""
    for b in "$@"; do out="$out \"refs/heads/$b\","; done
    echo "${out%,}"
}

# Ruleset de branches : $1 nom, $2 branches (liste), $3 méthodes de merge (JSON),
# $4 PR à jour exigée (défaut true), $5 approbations (défaut REVIEWS),
# $6 dernier push approuvé par un autre (défaut selon REVIEWS),
# $7 règle supplémentaire (JSON), ex. déploiement réussi exigé
branch_ruleset() {
    # shellcheck disable=SC2086 # liste de branches volontairement découpée
    cat <<JSON
{
  "name": "$1",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {"ref_name": {"include": [$(refs_json $2)], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "pull_request", "parameters": {
      "allowed_merge_methods": [$3],
      "dismiss_stale_reviews_on_push": true,
      "require_code_owner_review": $CODEOWNERS,
      "require_extra_approval_for_unattributed_changes": $UNATTRIBUTED,
      "require_last_push_approval": ${6:-$last_push},
      "required_approving_review_count": ${5:-$REVIEWS},
      "required_review_thread_resolution": true}},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": ${4:-true},
      "do_not_enforce_on_create": false,
      "required_status_checks": [$contexts]}}${7:+,
    $7}
  ]
}
JSON
}

# Tags de version v*. Organisation : posés uniquement par les workflows
# (GitHub Actions en exception). Compte personnel : GitHub n'accepte pas
# cette exception ; un tag publié ne peut alors être ni déplacé ni supprimé
# (exception : administrateurs, tracée), sa création restant libre.
tags_ruleset() { # $1 : Organization ou User
    local bypass rules
    if [ "$1" = Organization ]; then
        bypass='{"actor_id": 15368, "actor_type": "Integration", "bypass_mode": "always"}'
        rules='{"type": "creation"}, {"type": "update"}, {"type": "deletion"}'
    else
        bypass='{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}'
        rules='{"type": "update"}, {"type": "deletion"}'
    fi
    cat <<JSON
{
  "name": "repowarden (tags)",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [$bypass],
  "conditions": {"ref_name": {"include": ["refs/tags/v*"], "exclude": []}},
  "rules": [$rules]
}
JSON
}

rulesets=()
if [ -n "$integration" ]; then
    # main : livraisons (develop, release/…, hotfix/…) en merge commit, pour
    # garder le détail des commits dans l'historique et les notes de version ;
    # develop : travail en squash, merge commit pour release/… et hotfix/…
    others=""
    for b in $existing; do [ "$b" = "$integration" ] || others="$others $b"; done
    # Livraison vers main = passage à une nouvelle version : approbation
    # humaine obligatoire (la PR de livraison est ouverte par le workflow,
    # le mainteneur peut donc l'approuver), sans exiger un autre approbateur
    # que l'auteur du dernier push sauf si des relectures sont configurées.
    # Dev solo : pas de minimum (l'auteur de la PR ne peut pas l'approuver)
    livraison=$((REVIEWS > 0 ? REVIEWS : 1))
    [ "$solo" = false ] || livraison="$REVIEWS"
    # deliveryApproval = deployment (défaut) : la validation humaine est
    # l'approbation de l'environnement de livraison (« Approve and deploy »),
    # exigée par une règle de main (déploiement réussi) ; la revue de PR n'est
    # plus nécessaire (relectures configurées : gardées). review : revue de PR.
    # auto : choix du projet, la validation humaine est le merge de chaque
    # ticket ; la GitHub App arme le merge de la livraison (release-auto,
    # delivery-auto), qui part quand les vérifications exigées sont vertes.
    # Ni règle de déploiement ni environnement créé d'office ; vérifications
    # et relectures configurées gardées.
    cfg_r deliveryApproval deployment
    DELIVERY="$REPLY"
    [[ "$DELIVERY" =~ ^(deployment|review|auto)$ ]] || { err_t ci.proteger.delivery_invalid; exit 1; }
    deploiement=""
    if [ "$DELIVERY" = deployment ]; then
        ENVIRONMENT="${ENVIRONMENT:-production}"
        livraison="$REVIEWS"
        deploiement="{\"type\": \"required_deployments\", \"parameters\": {\"required_deployment_environments\": [\"$ENVIRONMENT\"]}}"
    elif [ "$DELIVERY" = auto ]; then
        livraison="$REVIEWS"
    fi
    # PR à jour non exigée non plus : le merge commit d'une livraison n'existe
    # que sur main ; strict, la livraison suivante serait bloquée tant que
    # develop ne l'a pas reçu (retour main → develop vide après chaque
    # release). Une livraison n'apporte que develop, vérifiée par la CI ; le
    # retour reste fait quand main a un contenu propre (correctif direct).
    # Garde-fou de livraison (statut posé par release-auto) : la livraison ne
    # se merge que si elle peut aboutir (préversion publiée, protection en place)
    contexts_branches="$contexts"
    if grep -qs "release-auto.yml" "$GIT_TOPLEVEL"/.github/workflows/*.y*ml; then
        contexts="${contexts:+$contexts,} {\"context\": \"livraison\", \"integration_id\": 15368}"
        livraison_exigee=1
    fi
    [ -z "$others" ] || rulesets+=("$(branch_ruleset repowarden "$others" '"merge"' false "$livraison" "$last_push" "$deploiement")")
    contexts="$contexts_branches"
    # Branche d'intégration : squash seul (un commit par PR de travail, titre =
    # message : les commits intermédiaires n'entrent jamais) ; plus de retour
    # main → develop à merger, seuls develop et ses instantanés livraison/*
    # entrant dans main. PR à jour non exigée : la CI vérifie chaque push.
    [[ " $existing " != *" $integration "* ]] ||
        rulesets+=("$(branch_ruleset "repowarden ($integration)" "$integration" '"squash"' false)")
    merge_commit=true
    # Nettoyage par le workflow nettoyage-branches (garde une branche encore
    # source d'une autre PR ouverte)
    delete_on_merge=false
    # Merge automatique autorisé pour les PR de travail vers develop (armé par
    # le suivi des tickets) ; une livraison vers main ne passe jamais sans son
    # approbation humaine, merge automatique ou non. autoMergeWork = false : aucun.
    cfg_r autoMergeWork true
    auto_merge="$REPLY"
    [[ "$auto_merge" =~ ^(true|false)$ ]] || { err_t ci.proteger.automerge_invalid; exit 1; }
    # Livraison automatique : merge automatique du dépôt indispensable
    if [ "$DELIVERY" = auto ] && [ "$auto_merge" = false ]; then
        err_t ci.proteger.auto_needs_automerge
        exit 1
    fi
    # Sans ce workflow, les branches mergées ne seraient plus supprimées
    if ! grep -qs "nettoyage-branches.yml" "$GIT_TOPLEVEL"/.github/workflows/*.y*ml; then
        attention_t ci.proteger.no_cleanup
    fi
    # Règle de déploiement sans workflow qui crée ce déploiement : main
    # bloquée pour toujours (la livraison n'aurait jamais d'approbation)
    if [ "$DELIVERY" = deployment ] &&
        ! grep -qs "delivery-environment:" "$GIT_TOPLEVEL"/.github/workflows/*.y*ml; then
        attention_t ci.proteger.no_delivery_env "$ENVIRONMENT"
    fi
    # Livraison automatique que rien n'arme : la PR se mergera à la main
    if [ "$DELIVERY" = auto ] &&
        ! grep -qsE "^[[:space:]]*delivery-auto:[[:space:]]*true" "$GIT_TOPLEVEL"/.github/workflows/*.y*ml; then
        attention_t ci.proteger.no_delivery_auto
    fi
    # Demande de livraison (manuelle, planifiée) qui ne remplace pas celle en
    # attente : une demande oubliée bloquerait en silence les suivantes
    for wf in "$GIT_TOPLEVEL"/.github/workflows/*.y*ml; do
        grep -qs "release-auto.yml" "$wf" && grep -qsE "workflow_dispatch|schedule:" "$wf" &&
            grep -qs "cancel-in-progress: false" "$wf" &&
            attention_t ci.proteger.stale_concurrency "${wf#"$GIT_TOPLEVEL"/}"
    done
    t ci.proteger.methods_flow "$integration"
    methods="$REPLY"
else
    rulesets+=("$(branch_ruleset repowarden "$existing" '"squash"')")
    merge_commit=false
    auto_merge=true
    delete_on_merge=true
    methods="squash"
fi
owner_type="$(gh api "repos/$REPO" --jq .owner.type)"
if [ -z "$NO_TAGS" ]; then
    rulesets+=("$(tags_ruleset "$owner_type")")
    if [ "$owner_type" = Organization ]; then
        t ci.proteger.tags_org
        tags_msg="$REPLY"
    else
        t ci.proteger.tags_user
        tags_msg="$REPLY"
    fi
else
    t ci.proteger.tags_none
    tags_msg="$REPLY"
fi

echo_t ci.proteger.1 "$REPO"
echo_t ci.proteger.2 "$existing"
echo_t ci.proteger.3 "$CHECKS"
[ -z "${livraison_exigee:-}" ] || echo_t ci.proteger.livraison_check
echo_t ci.proteger.4 "$methods" "$delete_on_merge"
if [ -n "$integration" ] && [ "$DELIVERY" = deployment ]; then
    echo_t ci.proteger.delivery_deploy "$ENVIRONMENT" "$auto_merge"
elif [ -n "$integration" ] && [ "$DELIVERY" = auto ]; then
    echo_t ci.proteger.delivery_auto "$livraison"
elif [ -n "$integration" ]; then
    echo_t ci.proteger.delivery "$livraison" "$auto_merge"
fi
echo_t ci.proteger.5 "$tags_msg"
[ -z "$integration" ] || echo_t ci.proteger.6 "$integration"
echo_t ci.proteger.7 "$REVIEWS" "$CODEOWNERS" "$UNATTRIBUTED"
[ "$solo" = false ] || echo_t ci.proteger.solo
if [ "$REVIEWS" != 0 ] || [ "$CODEOWNERS" = true ]; then
    echo_t ci.proteger.8
fi

# Environnement de déploiement : chaque job « environment: NOM » attend
# l'approbation d'une des personnes désignées ; déploiement seulement depuis
# les branches protégées et les tags v*
env_json=""
if [ -n "$ENVIRONMENT" ]; then
    [ -n "$APPROVERS" ] || APPROVERS="$(gh api user --jq .login)"
    reviewers=""
    # Personnes (login) ou équipes (@organisation/equipe : membres gérés dans GitHub)
    for login in $APPROVERS; do
        case "$login" in
            */*)
                team="${login#@}"
                id="$(gh api "orgs/${team%%/*}/teams/${team#*/}" --jq .id)" ||
                    { err_t ci.proteger.unknown_team "$login"; exit 1; }
                reviewers="$reviewers {\"type\": \"Team\", \"id\": $id},"
                ;;
            *)
                id="$(gh api "users/${login#@}" --jq .id)" || { err_t ci.proteger.unknown_user "$login"; exit 1; }
                reviewers="$reviewers {\"type\": \"User\", \"id\": $id},"
                ;;
        esac
    done
    # Seul approbateur = soi-même (projet solo) : l'auto-approbation reste permise
    self_review=true
    [ "$(wc -w <<<"$APPROVERS")" -gt 1 ] || self_review=false
    env_json="{\"reviewers\": [${reviewers%,}], \"prevent_self_review\": $self_review,
  \"deployment_branch_policy\": {\"protected_branches\": false, \"custom_branch_policies\": true}}"
    echo_t ci.proteger.9 "$ENVIRONMENT" "$APPROVERS"
fi
# Signature des champs posés par ce script : attendue (JSON produit ci-dessus)
# et en ligne (gh --jq), comparables sans jq ni python
sig_attendue() {
    local r="$1" deps checks
    deps="$(sed -n 's/.*"required_deployment_environments": \[\(.*\)\].*/\1/p' <<<"$r" | tr -d '" ')"
    checks="$(grep -o '"context": "[^"]*"' <<<"$r" | sed 's/"context": "\(.*\)"/\1/' | LC_ALL=C sort | paste -sd, -)"
    printf 'approbations=%s dernier_push=%s codeowners=%s deploiement=%s verifications=%s' \
        "$(sed -n 's/.*"required_approving_review_count": \([0-9]*\).*/\1/p' <<<"$r")" \
        "$(sed -n 's/.*"require_last_push_approval": \([a-z]*\).*/\1/p' <<<"$r")" \
        "$(sed -n 's/.*"require_code_owner_review": \([a-z]*\).*/\1/p' <<<"$r")" "$deps" "$checks"
}
# Anciens rulesets : rulesets de branche du dépôt, sous un autre nom que ceux
# de repowarden, qui exigent encore la vérification « repogarde » (retirée en
# v4) ; posés à la main ou par une ancienne version. Laissés à côté, ils
# bloqueraient les branches pour toujours. Une ligne par ruleset dans ANCIENS :
# id, nom, branches couvertes (~DEFAULT_BRANCH résolu : la branche par défaut
# change ensuite dans le flux develop), séparés par des tabulations.
# shellcheck disable=SC2016 # expressions jq (gh --jq), pas du shell
anciens_rulesets() {
    local ids id ligne defaut=""
    ANCIENS=""
    ids="$(gh api "repos/$REPO/rulesets" --jq '.[] | select(.target == "branch"
        and (.source_type // "Repository") == "Repository"
        and (.name | test("^(repowarden|repogarde)( \\(.*\\))?$") | not)) | .id')" || return 0
    for id in $ids; do
        ligne="$(gh api "repos/$REPO/rulesets/$id" --jq 'select([.rules[]? | select(.type == "required_status_checks")
            | .parameters.required_status_checks[].context] | index("repogarde"))
            | "\(.id)\t\(.name)\t\(.conditions.ref_name.include | join(" "))"')" || continue
        [ -n "$ligne" ] || continue
        if [[ "$ligne" == *"~DEFAULT_BRANCH"* ]]; then
            [ -n "$defaut" ] || defaut="$(gh api "repos/$REPO" --jq .default_branch)"
            ligne="${ligne//\~DEFAULT_BRANCH/refs/heads/$defaut}"
        fi
        ANCIENS="$ANCIENS$ligne"$'\n'
    done
}

# Ancien ruleset (ligne de ANCIENS) couvrant une des branches du ruleset $2 (JSON)
couvre() {
    local motifs m b
    read -ra motifs <<<"$(cut -f3 <<<"$1")"
    for m in ${motifs[@]+"${motifs[@]}"}; do
        [ "$m" != "~ALL" ] || return 0
        for b in $(grep -o '"refs/heads/[^"]*"' <<<"$2" | tr -d '"'); do
            # shellcheck disable=SC2053 # motif de GitHub (refs/heads/release/*)
            [[ "$b" != $m ]] || return 0
        done
    done
    return 1
}

# Réponse d'erreur de GitHub (JSON) → « message : erreurs », lisible
erreur_github() {
    local message="" erreurs="" re_message='"message": *"([^"]*)"' re_erreurs='"errors": *\[([^]]*)\]'
    [[ ! "$1" =~ $re_message ]] || message="${BASH_REMATCH[1]}"
    [[ ! "$1" =~ $re_erreurs ]] || erreurs="${BASH_REMATCH[1]//\"/}"
    if [ -n "$message" ]; then
        REPLY="$message${erreurs:+ : $erreurs}"
    else
        REPLY="$(tr '\n' ' ' <<<"$1")"
    fi
}

# Rulesets indisponibles (dépôt privé d'un compte gratuit : GitHub les refuse
# en 403) : les réglages du dépôt restent appliqués, les rulesets sautés avec
# un message clair au lieu d'un arrêt sans explication
RULESETS_OK=1
! github_sans_rulesets "$REPO" || RULESETS_OK=""
ANCIENS=""
[ -z "$RULESETS_OK" ] || anciens_rulesets

# shellcheck disable=SC2016 # expression jq (gh --jq), pas du shell
SIG_EN_LIGNE='(.rules | map(select(.type == "pull_request"))[0].parameters) as $p
    | "approbations=\($p.required_approving_review_count) dernier_push=\($p.require_last_push_approval) codeowners=\($p.require_code_owner_review) deploiement=\([.rules[] | select(.type == "required_deployments") | .parameters.required_deployment_environments[]] | join(",")) verifications=\([.rules[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context] | sort | join(","))"'

if [ -n "$VERIFY" ] && [ -z "$RULESETS_OK" ]; then
    err_t ci.proteger.rulesets_unavailable "$REPO"
    exit 1
fi
if [ -n "$VERIFY" ]; then
    ecarts=0
    for ruleset in "${rulesets[@]}"; do
        grep -q '"target": "branch"' <<<"$ruleset" || continue
        name="$(sed -n 's/^  "name": "\(.*\)",$/\1/p' <<<"$ruleset")"
        attendu="$(sig_attendue "$ruleset")"
        id="$(gh api "repos/$REPO/rulesets" --jq ".[] | select(.name == \"$name\") | .id")"
        en_ligne=""
        [ -z "$id" ] || en_ligne="$(gh api "repos/$REPO/rulesets/$id" --jq "$SIG_EN_LIGNE")"
        # Vérifications exigées : comparées seulement si --checks est donné (la
        # liste n'est pas dans .repowarden.conf ; sinon faux écart)
        if [ -z "$CHECKS_SET" ]; then
            attendu="${attendu% verifications=*}"
            en_ligne="${en_ligne% verifications=*}"
        fi
        if [ -z "$en_ligne" ]; then
            err_t ci.proteger.verify_missing "$name"
            ecarts=$((ecarts + 1))
        elif [ "$en_ligne" != "$attendu" ]; then
            err_t ci.proteger.verify_diff "$name" "$en_ligne" "$attendu"
            ecarts=$((ecarts + 1))
        fi
    done
    while IFS=$'\t' read -r id name _; do
        [ -n "$id" ] || continue
        err_t ci.proteger.verify_legacy "$name" "$id"
        ecarts=$((ecarts + 1))
    done <<<"$ANCIENS"
    [ "$ecarts" = 0 ] || { err_t ci.proteger.verify_fix; exit 1; }
    ok_t ci.proteger.verify_ok
    exit 0
fi

# Étiquette « urgent » (flux develop) : son merge lance la demande de livraison
urgent=""
if [ -n "$integration" ] && ! gh api "repos/$REPO/labels/urgent" --silent 2>/dev/null; then
    urgent=1
    info_t ci.proteger.urgent
fi

if [ -n "$DRY_RUN" ]; then
    if [ -z "$RULESETS_OK" ]; then
        attention_t ci.proteger.rulesets_unavailable "$REPO"
        # Même offre : merge automatique ignoré par GitHub (PATCH accepté)
        [ "$auto_merge" = false ] || attention_t ci.proteger.automerge_unavailable
    fi
    printf '%s\n' "${rulesets[@]}"
    [ -z "$env_json" ] || printf '%s\n' "$env_json"
    exit 0
fi

# Sans rulesets, le mode de merge ne peut pas être imposé par branche : dans le
# flux develop, merge commit seul (une livraison squashée casserait l'historique)
squash=true
if [ -z "$RULESETS_OK" ] && [ -n "$integration" ]; then
    squash=false
    attention_t ci.proteger.no_squash
fi
echecs=0
# Appel de l'API dont le refus n'arrête pas le reste : $1 clé i18n de ce qui
# est réglé, puis la commande ; refus affiché avec le détail de GitHub (sans
# --silent, gh garde la réponse) et compté comme échec
appliquer() {
    local quoi="$1" reponse detail
    shift
    reponse="$("$@" 2>&1)" && return 0
    erreur_github "$reponse"
    detail="$REPLY"
    t "$quoi"
    err_t ci.proteger.settings_error "$REPLY" "$detail"
    echecs=$((echecs + 1))
    return 1
}
settings=(-F allow_squash_merge="$squash" -F allow_merge_commit="$merge_commit" -F allow_rebase_merge=false
    -F delete_branch_on_merge="$delete_on_merge" -F allow_auto_merge="$auto_merge")
# Titre et corps du squash seulement si le squash est autorisé : envoyés avec
# allow_squash_merge=false (dépôt sans rulesets, flux develop), GitHub refuse
# tout le PATCH en 422 « Validation Failed »
[ "$squash" = false ] || settings+=(-f squash_merge_commit_title=PR_TITLE -f squash_merge_commit_message=PR_BODY)
[ -z "$integration" ] || settings+=(-f default_branch="$integration")
if appliquer ci.proteger.what_repo gh api -X PATCH "repos/$REPO" "${settings[@]}" &&
    [ "$auto_merge" = true ] &&
    [ "$(gh api "repos/$REPO" --jq .allow_auto_merge 2>/dev/null || true)" != true ]; then
    # Merge automatique demandé mais resté désactivé : GitHub l'ignore sans
    # erreur (dépôt privé d'une offre gratuite)
    attention_t ci.proteger.automerge_ignored "$REPO"
    if [ -n "$integration" ] && [ "$DELIVERY" = auto ]; then
        err_t ci.proteger.automerge_delivery
        echecs=$((echecs + 1))
    fi
fi
appliquer ci.proteger.what_workflow gh api -X PUT "repos/$REPO/actions/permissions/workflow" \
    -f default_workflow_permissions=read -F can_approve_pull_request_reviews=true || true

[ -n "$RULESETS_OK" ] || { attention_t ci.proteger.rulesets_unavailable "$REPO"; rulesets=(); }
for ruleset in ${rulesets[@]+"${rulesets[@]}"}; do
    name="$(sed -n 's/^  "name": "\(.*\)",$/\1/p' <<<"$ruleset")"
    # Ruleset posé sous l'ancien nom (repogarde, v3) : repris et renommé, sinon
    # il resterait à côté et exigerait une vérification « repogarde » disparue
    old="${name/repowarden/repogarde}"
    id="$(gh api "repos/$REPO/rulesets" \
        --jq "([.[] | select(.name == \"$name\")] + [.[] | select(.name == \"$old\")]) | .[0].id // empty")"
    # Sinon, un ancien ruleset sous un autre nom couvrant ses branches : repris
    # (mis à jour en place, jamais un instant sans protection)
    repris=""
    if [ -z "$id" ] && grep -q '"target": "branch"' <<<"$ruleset"; then
        while IFS= read -r ligne; do
            { [ -n "$ligne" ] && couvre "$ligne" "$ruleset"; } || continue
            id="${ligne%%$'\t'*}"
            repris="$(cut -f2 <<<"$ligne")"
            ANCIENS="$(grep -v "^$id"$'\t' <<<"$ANCIENS" || true)"
            break
        done <<<"$ANCIENS"
    fi
    if [ -n "$id" ]; then
        methode=PUT chemin="repos/$REPO/rulesets/$id"
    else
        methode=POST chemin="repos/$REPO/rulesets"
    fi
    # Réponse gardée : en cas de refus, le détail de GitHub est affiché
    if reponse="$(gh api -X "$methode" "$chemin" --input - <<<"$ruleset" 2>&1)"; then
        if [ -n "$repris" ]; then
            ok_t ci.proteger.legacy_taken "$name" "$repris"
        elif [ -n "$id" ]; then
            ok_t ci.proteger.10 "$name"
        else
            ok_t ci.proteger.11 "$name"
        fi
    elif [ "$name" = "repowarden (tags)" ] && [ "$owner_type" = Organization ] &&
        [[ "$reponse" == *"ruleset source or owner organization"* ]] &&
        gh api -X "$methode" "$chemin" --input - <<<"$(tags_ruleset User)" >/dev/null 2>&1; then
        # Exception GitHub Actions refusée (App non installée dans l'organisation) :
        # règle des comptes personnels, tags ni déplacés ni supprimés
        attention_t ci.proteger.tags_fallback
    else
        erreur_github "$reponse"
        err_t ci.proteger.api_error "$name" "$REPLY"
        echecs=$((echecs + 1))
    fi
done
# Anciens rulesets non repris (plusieurs sur les mêmes branches) : jamais
# supprimés ici, la marche à suivre est donnée
while IFS=$'\t' read -r id name _; do
    [ -n "$id" ] || continue
    err_t ci.proteger.legacy_left "$name" "$id" "$REPO" "$id"
    echecs=$((echecs + 1))
done <<<"$ANCIENS"
if [ -n "$env_json" ]; then
    appliquer ci.proteger.what_environment gh api -X PUT "repos/$REPO/environments/$ENVIRONMENT" --input - <<<"$env_json" || env_json=""
fi
if [ -n "$env_json" ]; then
    policies="$(gh api "repos/$REPO/environments/$ENVIRONMENT/deployment-branch-policies" \
        --jq '.branch_policies[] | "\(.type):\(.name)"')"
    for policy in $(for b in $existing; do echo "branch:$b"; done) "tag:v*"; do
        grep -qxF "$policy" <<<"$policies" && continue
        gh api -X POST "repos/$REPO/environments/$ENVIRONMENT/deployment-branch-policies" --silent \
            -f type="${policy%%:*}" -f name="${policy#*:}"
    done
    ok_t ci.proteger.12 "$ENVIRONMENT"
fi
[ -z "$urgent" ] || gh label create urgent -R "$REPO" --color B60205 \
    --description "Livraison immédiate après merge" >/dev/null
[ "$echecs" = 0 ] || { err_t ci.proteger.incomplete; exit 1; }
ok_t ci.proteger.13
