#!/usr/bin/env bash
# Usage : repowarden cc [options de git commit]   (alias : git cc, installé par install.sh)
#         repowarden cc -m "description" [--type T] [--scope S] [--breaking NOTE] [--body TEXTE] [--refs "Ticket : #12"]
#         repowarden cc --dry-run
#
# Assistant de commit conventionnel : guide l'en-tête, le corps et le pied,
# puis commit via les hooks habituels. Sans question (-m : scripts, agents) :
# mêmes contrôles, type et scope déduits de la branche s'ils sont omis.
#   --strict    une réponse refusée arrête tout (rien n'est commité)
#   --dry-run   affiche le message sans commiter
# Les réponses sont lues sur l'entrée standard (terminal avec édition de ligne,
# ou fichier/tube pour les tests). Le commit passe ensuite par les hooks
# habituels. Couleurs désactivables : NO_COLOR=1.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"
# shellcheck source=../hooks/lib/tickets.sh
source "$ROOT/hooks/lib/tickets.sh"

# Charte visuelle commune (hooks/lib/ui.sh, chargée par common.sh)
B="$UI_B" D="$UI_D" G="$UI_G" R="$UI_R" C="$UI_C" N="$UI_N"
STEPS=5

# Sans question (BATCH) : ni étapes ni aides, seulement les erreurs et l'aperçu
etape() { [ -z "$BATCH" ] || return 0; printf '\n%s◇ %s/%s%s  %s%s%s\n' "$C" "$1" "$STEPS" "$N" "$B" "$2" "$N" >&2; }
hint() { [ -z "$BATCH" ] || return 0; printf '  %s%s%s\n' "$D" "$*" "$N" >&2; }
fail() { printf '  %s✖ %s%s\n' "$R" "$*" "$N" >&2; }
# Réponse refusée : la question est reposée ; avec --strict, abandon (rien
# n'est commité) plutôt que de lire la réponse suivante d'un script
refuse() {
    fail "$1"
    [ -z "$STRICT" ] || { t cc.strict_abort; fail "$REPLY"; exit 1; }
}

# Réponse dans REPLY, nettoyée : séquences d'échappement (flèches, Échap) et
# caractères de contrôle retirés, espaces de début et de fin supprimés.
# Dans un terminal, édition de ligne (flèches, effacement) avec read -e.
# Sans question (BATCH) : la réponse est ANSWER, fixée par l'appelant.
ask() {
    if [ -n "$BATCH" ]; then
        REPLY="$ANSWER"
    elif [ -t 0 ]; then
        # Ctrl+D (fin de saisie) : abandon
        IFS= read -e -r -p "$1" REPLY || { echo >&2; t cc.aborted; fail "$REPLY"; exit 1; }
    else
        printf '%s' "$1" >&2
        # Fin de la saisie (entrée épuisée) : abandon, jamais de boucle infinie
        if ! IFS= read -r REPLY; then
            [ -n "$REPLY" ] || { echo >&2; t cc.aborted; fail "$REPLY"; exit 1; }
        fi
    fi
    REPLY="$(printf '%s' "$REPLY" | LC_ALL=C sed -e $'s/\x1b\\[[0-9;?]*[ -\\/]*[@-~]//g' -e $'s/\x1b.//g' |
        LC_ALL=C tr -d '\000-\010\013-\037\177')"
    REPLY="${REPLY#"${REPLY%%[![:space:]]*}"}"
    REPLY="${REPLY%"${REPLY##*[![:space:]]}"}"
}

# Question oui/non : $1 invite, $2 réponse par défaut (o ou n). Toute autre
# réponse est refusée et la question reposée. Résultat : YN=1 pour oui.
ask_yn() {
    while :; do
        ask "$1"
        case "${REPLY:-$2}" in
            o | O | oui | Oui | OUI | y | Y | yes | Yes | YES) YN=1; return 0 ;;
            n | N | non | Non | NON | no | No | NO) YN=""; return 0 ;;
        esac
        t cc.yn_invalid
        refuse "$REPLY"
    done
}

DRY_RUN="" STRICT="" BATCH="" ANSWER=""
PASS=() # options transmises à git commit (--no-verify…)
OPT_TYPE="" OPT_SCOPE="" OPT_MESSAGE="" OPT_BODY="" OPT_REFS="" OPT_BREAKING=""
# Valeur d'une option : « --type feat » ou « --type=feat »
option_value() {
    case "$1" in
        *=*) REPLY="${1#*=}"; SHIFT=1 ;;
        *)
            [ $# -ge 2 ] || { t cc.option_value "$1"; fail "$REPLY"; exit 1; }
            REPLY="$2"; SHIFT=2
            ;;
    esac
}
while [ $# -gt 0 ]; do
    SHIFT=1
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        --strict) STRICT=1 ;;
        --type | --type=*) option_value "$@"; OPT_TYPE="$REPLY"; BATCH=1 ;;
        --scope | --scope=*) option_value "$@"; OPT_SCOPE="$REPLY"; BATCH=1 ;;
        -m | --message | --message=*) option_value "$@"; OPT_MESSAGE="$REPLY"; BATCH=1 ;;
        --body | --body=*) option_value "$@"; OPT_BODY="$REPLY"; BATCH=1 ;;
        --refs | --refs=*) option_value "$@"; OPT_REFS="$REPLY"; BATCH=1 ;;
        --breaking | --breaking=*) option_value "$@"; OPT_BREAKING="$REPLY"; BATCH=1 ;;
        --) shift; PASS+=("$@"); break ;;
        *) PASS+=("$1") ;;
    esac
    shift "$SHIFT"
done
# Sans question : les valeurs viennent des options, aucune n'est redemandée
if [ -n "$BATCH" ]; then
    STRICT=1
    [ -n "$OPT_MESSAGE" ] || { t cc.batch_message_required; fail "$REPLY"; exit 1; }
fi

if [ -z "$DRY_RUN" ] && git diff --cached --quiet; then
    t cc.nothing_staged
    fail "$REPLY"
    exit 1
fi

TYPES=(feat fix docs style refactor perf test build ci chore revert)
# Emojis à la gitmoji : repères visuels du menu, jamais écrits dans le message
EMOJIS=(✨ 🐛 📝 🎨 ♻️ ⚡ ✅ 📦 👷 🔧 ⏪)
DESCRIPTIONS=()
for _type in "${TYPES[@]}"; do
    t "cc.type.$_type"
    DESCRIPTIONS+=("$REPLY")
done

# Valeurs proposées d'après la branche : feat/panier → feat, panier. Branche
# hors convention (wip/xyz, essai/xyz) : rien n'est proposé, le type doit être
# choisi (Entrée donnerait sinon un feat, donc une version mineure, par erreur).
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
first_commit=""
git rev-parse -q --verify HEAD >/dev/null || first_commit=1
default_type="feat"
default_scope=""
if [[ "$branch" == */* ]]; then
    prefix="${branch%%/*}"
    case "$prefix" in feature) prefix=feat ;; bugfix | hotfix) prefix=fix ;; esac
    if [[ "$prefix" =~ ^($CC_TYPES)$ ]]; then
        default_type="$prefix"
        default_scope="$(echo "${branch#*/}" | tr '[:upper:]/' '[:lower:]-' | tr -cd 'a-z0-9._-')"
        [ "${#default_scope}" -le 20 ] || default_scope=""
    else
        default_type=""
    fi
fi

if [ -z "$BATCH" ]; then
    t cc.title
    brand "$REPLY" >&2
    t cc.help
    printf '%s%s%s\n' "$D" "$REPLY" "$N" >&2
fi

# 1. Type
t cc.step1
etape 1 "$REPLY"
[ -n "$BATCH" ] || for i in "${!TYPES[@]}"; do
    printf '  %s%2d%s  %s  %s%-9s%s %s%s%s\n' "$D" "$((i + 1))" "$N" "${EMOJIS[$i]}" "$B" "${TYPES[$i]}" "$N" "$D" "${DESCRIPTIONS[$i]}" "$N" >&2
done
while :; do
    if [ -n "$default_type" ]; then t cc.type_prompt "$default_type"; else t cc.type_prompt_required; fi
    ANSWER="$OPT_TYPE"
    ask "$REPLY"
    answer="${REPLY:-$default_type}"
    if [ -z "$answer" ]; then
        t cc.type_required
        refuse "$REPLY"
        continue
    elif [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -ge 1 ] && [ "$answer" -le "${#TYPES[@]}" ]; then
        type="${TYPES[$((answer - 1))]}"
        break
    elif [[ "$answer" =~ ^($CC_TYPES)$ ]]; then
        type="$answer"
        break
    fi
    type_proche_r "$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')"
    if [ -n "$REPLY" ]; then
        t cc.type_invalid_suggest "$answer" "$REPLY" "${#TYPES[@]}"
    else
        t cc.type_invalid "$answer" "${#TYPES[@]}"
    fi
    refuse "$REPLY"
done

# 2. Scope (optionnel)
t cc.step2
etape 2 "$REPLY"
if [ -n "$default_scope" ]; then t cc.scope_hint_default "$default_scope"; else t cc.scope_hint; fi
hint "$REPLY"
while :; do
    if [ -n "$default_scope" ]; then
        t cc.scope_prompt_default "$default_scope"
        ANSWER="$OPT_SCOPE"
        ask "$REPLY"
        scope="${REPLY:-$default_scope}"
        [ "$scope" = - ] && scope=""
    else
        t cc.scope_prompt
        ANSWER="$OPT_SCOPE"
        ask "$REPLY"
        scope="$REPLY"
        [ "$scope" = - ] && scope="" # « - » : aucun scope, comme avec une proposition
    fi
    [[ -z "$scope" || "$scope" =~ ^[a-z0-9._-]+$ ]] && break
    # Version corrigée proposée (« Doc Test » → « doc-test ») : Entrée pour l'accepter
    fixed="$(printf '%s' "$scope" | tr '[:upper:] ' '[:lower:]-' | LC_ALL=C tr -cd 'a-z0-9._-' | tr -s '-')"
    fixed="${fixed#-}"
    fixed="${fixed%-}"
    if [ -n "$fixed" ]; then
        t cc.scope_fixed "$fixed"
        default_scope="$fixed"
    else
        t cc.scope_invalid
    fi
    refuse "$REPLY"
done

# Branche protégée (main…) : le commit y serait refusé. On le dit tout de suite
# et on propose une branche <type>/<scope>, les modifications suivent.
cfg_r protectedBranches "main master"
protected="$REPLY" # à garder : skipped réécrit REPLY
if [ -z "$first_commit" ] && [ -z "$DRY_RUN" ] && ! skipped protect-branch &&
    [[ " $protected " == *" $branch "* ]]; then
    t cc.topic_default
    suggestion="$type/${scope:-$REPLY}"
    t cc.protected_hint "$branch"
    printf '\n  %s%s%s\n' "$B" "$REPLY" "$N" >&2
    # Sans question (-m : scripts, agents) : jamais de branche créée à la place
    # de l'appelant ; la commande à lancer, plutôt qu'un abandon muet
    if [ -n "$BATCH" ]; then
        t cc.protected_batch "$suggestion"
        printf '%s\n' "$REPLY" >&2
        exit 1
    fi
    while :; do
        t cc.new_branch_prompt "$suggestion"
        ask "$REPLY"
        name="${REPLY:-$suggestion}"
        # Réponse incomplète ou approximative : complétée (« feat » → feat/<scope>,
        # « Mon Test » → feat/mon-test) puis proposée, sans refus sec
        if [[ "$name" != */* && "$name" =~ ^($CC_TYPES|feature|bugfix|hotfix)$ ]]; then
            name="$name/${suggestion#*/}"
        fi
        case "$name" in n | N | non | no)
            t cc.aborted
            printf '%s%s%s\n' "$D" "$REPLY" "$N" >&2
            exit 1
            ;;
        esac
        if branch_name_valid "$name" && ! git show-ref -q --verify "refs/heads/$name" &&
            git switch -q -c "$name" </dev/null >/dev/null 2>&1; then
            branch="$name"
            t cc.branch_created "$name"
            hint "$REPLY"
            break
        fi
        if git show-ref -q --verify "refs/heads/$name"; then
            t cc.branch_exists "$name"
        else
            suggestion="$(suggest_branch_name "$name")"
            t cc.branch_fixed "$name" "$suggestion"
        fi
        refuse "$REPLY"
    done
fi

# 3. Changement incompatible (version majeure) : sans objet au premier commit
t cc.step3
etape 3 "$REPLY"
breaking=""
breaking_note=""
if [ -n "$first_commit" ]; then
    t cc.first_commit
    hint "$REPLY"
else
    t cc.breaking_hint1
    hint "$REPLY"
    t cc.breaking_hint2
    hint "$REPLY"
    t cc.breaking_prompt
    ANSWER="${OPT_BREAKING:+o}"
    ask_yn "$REPLY" n
    breaking="$YN"
    if [ -n "$breaking" ]; then
        t cc.breaking_note_hint
        hint "$REPLY"
        while :; do
            t cc.breaking_note_prompt
            ANSWER="$OPT_BREAKING"
            ask "$REPLY"
            if [ "${#REPLY}" -ge 10 ] && [[ ! "$REPLY" =~ ^(RAS|ras|rien|aucun|none|-|\.)$ ]]; then
                breaking_note="$REPLY"
                break
            fi
            t cc.breaking_note_invalid
            refuse "$REPLY"
        done
    fi
fi

header_prefix="$type${scope:+($scope)}${breaking:+!}: "

# 4. Description, avec contrôle de longueur de l'en-tête
t cc.step4
etape 4 "$REPLY"
authored_length "$header_prefix"
max=$((72 - REPLY))
t cc.desc_hint "$max"
hint "$REPLY"
while :; do
    ANSWER="$OPT_MESSAGE"
    ask "$header_prefix"
    description="$REPLY"
    description="${description%.}"
    if [ -z "$description" ]; then
        t cc.desc_required
        refuse "$REPLY"
        continue
    fi
    authored_length "$header_prefix$description"
    if [ "$REPLY" -gt 72 ]; then
        t cc.header_too_long "$REPLY"
        refuse "$REPLY"
        continue
    fi
    break
done

# 5. Détails (optionnels) : corps puis références
t cc.step5
etape 5 "$REPLY"
t cc.body_hint
hint "$REPLY"
body=""
if [ -n "$BATCH" ]; then
    [ -z "$OPT_BODY" ] || body="${OPT_BODY%$'\n'}"$'\n'
fi
while [ -z "$BATCH" ]; do
    ask "> "
    # Ligne vide, ou faite seulement de ponctuation (« ; », « . »…) : fin du corps
    [[ -n "$REPLY" && ! "$REPLY" =~ ^[[:punct:]]+$ ]] || break
    body="$body$REPLY"$'\n'
done
# Branche type/12-sujet : ticket #12 proposé (Entrée l'accepte, « - » : aucun)
ticket=""
branch_ticket_r "$branch"
[ -z "$REPLY" ] || ticket="Ticket : #$REPLY"
# Branche de travail sans ticket : prévenu, jamais bloqué. Création proposée
# seulement si repowarden gère la vie des tickets du projet ET ticketAutoCreate (et sans -m)
if [ -z "$ticket" ] && [ -z "$DRY_RUN" ] && ! skipped tickets && work_branch "$branch"; then
    if [ -z "$BATCH" ] && tickets_managed && ticket_auto_create && has gh; then
        t cc.ticket_offer
        ask_yn "$REPLY" n
        if [ -n "$YN" ] && n="$(bash "$ROOT/bin/ticket" nouveau "$description" --type "$type" --porcelain)" && [ -n "$n" ]; then
            ticket="Ticket : #$n"
            t cc.ticket_created "$n"
            hint "$REPLY"
        fi
    else
        ticket_hint "$branch"
    fi
fi
if [ -n "$ticket" ]; then
    t cc.refs_prompt_ticket "$ticket"
else
    cfg_r integrationBranch ""
    if [ -n "$REPLY" ]; then t cc.refs_prompt "Ticket : #12"; else t cc.refs_prompt "$FORGE_REFS"; fi
fi
ANSWER="$OPT_REFS"
ask "$REPLY"
refs="${REPLY:-$ticket}"
[ "$refs" != - ] || refs=""

# Message final : en-tête, puis corps et pied séparés par une ligne vide
footer=""
[ -z "$breaking_note" ] || footer="BREAKING CHANGE: $breaking_note"$'\n'
[ -z "$refs" ] || footer="$footer$refs"$'\n'
message="$header_prefix$description"$'\n'
[ -z "$body" ] || message="$message"$'\n'"$body"
[ -z "$footer" ] || message="$message"$'\n'"$footer"

t cc.preview
printf '\n%s┌─ %s ───────────────────────────────────────────────%s\n' "$D" "$REPLY" "$N" >&2
while IFS= read -r line; do
    printf '%s│%s %s\n' "$D" "$N" "$line" >&2
done <<<"${message%$'\n'}"
printf '%s└─────────────────────────────────────────────────────────%s\n' "$D" "$N" >&2

if [ -n "$DRY_RUN" ]; then
    printf '%s' "$message"
    exit 0
fi

t cc.confirm
ANSWER=o
ask_yn "$REPLY" o
if [ -z "$YN" ]; then
    t cc.aborted
    printf '%s%s%s\n' "$D" "$REPLY" "$N" >&2
    exit 1
fi

# Message gardé dans le dépôt si le commit est refusé (hook, secret…) : rien à ressaisir
file="$(git rev-parse --git-dir)/repowarden-message"
printf '%s' "$message" >"$file"
if ! git commit -F "$file" ${PASS[@]+"${PASS[@]}"}; then
    t cc.kept "$file"
    printf '\n%s%s%s\n' "$B" "$REPLY" "$N" >&2
    exit 1
fi
rm -f "$file"

# Suite : rappel de la convention de branches
cfg_r protectedBranches "main master"
protected="$REPLY"
t cc.created
created="$REPLY"
if [[ " $protected " == *" $branch "* ]]; then
    t cc.topic
    t cc.next_branch "${B}git switch -c $type/<$REPLY>$N" "$FORGE_PR"
else
    t cc.next_push "${B}git push -u origin $branch$N"
fi
printf '\n%s%s✔ %s%s %s\n' "$G" "$B" "$created" "$N" "$REPLY" >&2
