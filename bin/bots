#!/usr/bin/env bash
# Bots du dépôt GitHub courant, configurés avec l'accord de l'utilisateur :
#   repowarden bots              questions, aperçu, puis confirmation
#   repowarden install --bots    (idem, après l'installation des hooks)
#   repowarden install --sans-bots
#                                ne plus jamais le proposer (repowarden.bots = off)
# Rien n'est fait sans accord : une question globale (non par défaut), le
# flux (main seul, ou develop → main), un accord par bot (CI, releases,
# nettoyage, tickets, App, protection, npm), la livraison (flux develop avec
# releases : automatique ou approuvée, rythme, préversion obligatoire),
# l'aperçu de ce qui sera créé ou modifié, puis une confirmation finale. Un
# fichier existant n'est jamais écrasé. Relançable pour compléter. Demande un
# terminal, gh connecté et les droits d'administration du dépôt.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"
# Détection des langages des hooks (marqueurs des plugins) : outillage de la CI
# shellcheck source=../hooks/lib/lang.sh
source "$ROOT/hooks/lib/lang.sh"

aide() { _tr help.bots; printf '%b\n' "$_T" >&2; }

# Commandes enchaînées (remplaçables dans les tests)
BIN="${REPOWARDEN_BIN:-$ROOT/bin}"
DEPUIS_INSTALL=""
while [ $# -gt 0 ]; do
    case "$1" in
        --depuis-install) DEPUIS_INSTALL=1 ;;
        -h | --help) aide; exit 0 ;;
        *) err_t install.unknown_arg "$1"; exit 1 ;;
    esac
    shift
done

# Rien n'est proposé : une ligne dit pourquoi, et comment le faire plus tard
pas_maintenant() { # $1 clé de la raison
    t "$1"
    info_t bots.skip "$REPLY"
    exit 0
}

# Refus permanent (install --sans-bots) : silence depuis l'installation
if [ -n "$DEPUIS_INSTALL" ] && [ "$(git config --get repowarden.bots 2>/dev/null || true)" = off ]; then
    exit 0
fi
[ -n "$GIT_TOPLEVEL" ] || pas_maintenant bots.why_repo
cd "$GIT_TOPLEVEL"
[ "$FORGE" = github ] || pas_maintenant bots.why_github
command -v gh >/dev/null || pas_maintenant bots.why_gh
gh auth status >/dev/null 2>&1 || pas_maintenant bots.why_gh_login
REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
[ -n "$REPO" ] || pas_maintenant bots.why_github
[ "$(gh api "repos/$REPO" --jq .permissions.admin 2>/dev/null || true)" = true ] || pas_maintenant bots.why_admin
# Terminal (ou réponses fournies, tests) : sinon, jamais de question
[ -t 0 ] || [ -n "${REPOWARDEN_INTERACTIF:-}" ] || pas_maintenant bots.why_tty

# Question fermée : $1 clé, $2 défaut (o ou n) ; vrai si oui
demander() {
    local reponse choix="o/N"
    [ "$2" = n ] || choix="O/n"
    t "$1"
    printf '%s [%s] ' "$REPLY" "$choix" >&2
    IFS= read -r reponse || reponse=""
    case "$reponse" in
        "") [ "$2" = o ] ;;
        [oOyY]*) return 0 ;;
        *) return 1 ;;
    esac
}

brand "bots · $REPO"
# Dépôt privé d'une offre gratuite : ni protection, ni rulesets, ni merge
# automatique ; dit avant toute question, pour décider en connaissance de cause
SANS_RULESETS=""
if github_sans_rulesets "$REPO"; then
    SANS_RULESETS=1
    attention_t bots.plan_limited "$REPO"
fi
demander bots.ask_global n || { info_t bots.later; exit 0; }

# --- Flux ------------------------------------------------------------------
cfg_r integrationBranch ""
INTEGRATION="$REPLY"
DEFAUT="$(gh api "repos/$REPO" --jq .default_branch)"
PRINCIPALE=main
[ "$DEFAUT" = master ] && PRINCIPALE=master
echo >&2
t bots.flow_question
printf '%s\n' "$REPLY" >&2
t bots.flow_main "$PRINCIPALE"
printf '  1) %s\n' "$REPLY" >&2
t bots.flow_develop "$PRINCIPALE" "$PRINCIPALE"
printf '  2) %s\n' "$REPLY" >&2
# develop → main par défaut : seul develop entre dans main
choix_flux=2
read -r -p "[$choix_flux] : " reponse || reponse=""
case "${reponse:-$choix_flux}" in
    2*) FLUX=develop; INTEGRATION="${INTEGRATION:-develop}" ;;
    *) FLUX=main; INTEGRATION="" ;;
esac
CREER_DEVELOP=""
# Nom renvoyé comparé : sur une 404, gh écrit le corps de l'erreur sur stdout
if [ "$FLUX" = develop ] &&
    [ "$(gh api "repos/$REPO/branches/$INTEGRATION" --jq .name 2>/dev/null || true)" != "$INTEGRATION" ]; then
    if demander bots.ask_create_develop o; then
        CREER_DEVELOP=1
    else
        FLUX=main INTEGRATION=""
    fi
fi

# --- Un accord par bot -----------------------------------------------------
echo >&2
info_t bots.one_by_one
APP_PRESENTE=""
[ -z "$(gh variable get REPOWARDEN_APP_CLIENT_ID --repo "$REPO" 2>/dev/null || true)" ] || APP_PRESENTE=1
NPM_POSSIBLE=""
[ ! -f package.json ] || grep -qE '"private": *true' package.json || NPM_POSSIBLE=1
BOTS=()
for bot in ci release nettoyage tickets app proteger npm; do
    case "$bot" in
        nettoyage) [ "$FLUX" = develop ] || continue ;;
        app) [ -z "$APP_PRESENTE" ] || { info_t bots.app_present; continue; } ;;
        npm) [ -n "$NPM_POSSIBLE" ] || continue ;;
    esac
    dim_t "bots.desc_$bot"
    demander "bots.ask_$bot" o && BOTS+=("$bot")
done
[ "${#BOTS[@]}" -gt 0 ] || [ -n "$CREER_DEVELOP" ] || { info_t bots.later; exit 0; }
choisi() { [[ " ${BOTS[*]+"${BOTS[*]}"} " == *" $1 "* ]]; }
AVEC_APP=""
{ [ -n "$APP_PRESENTE" ] || choisi app; } && AVEC_APP=1
# Livraison approuvée par l'environnement (« Approve and deploy ») : avec
# l'App, sauf sur un dépôt sans rulesets (ni règle de déploiement exigée, ni
# environnement avec approbation sur un dépôt privé gratuit) : revue de sa PR
LIVRAISON_ENV=""
[ -z "$AVEC_APP" ] || [ -n "$SANS_RULESETS" ] || LIVRAISON_ENV=1

# --- Livraison (flux develop, releases) : mode, rythme, préversion -----------
# Défauts : le release.yml d'aujourd'hui (approbation, regroupé, préversion
# obligatoire) ; chaque réponse devient une entrée de release-auto.yml
LIVRAISON_AUTO="" A_CHAQUE_TICKET="" PREVERSION_OBLIGATOIRE=1
if [ "$FLUX" = develop ] && choisi release; then
    echo >&2
    dim_t bots.desc_delivery
    if [ -n "$SANS_RULESETS" ]; then
        # Livraison automatique = merge automatique, ignoré par GitHub ici
        info_t bots.no_delivery_auto
    elif demander bots.ask_delivery_auto n; then
        LIVRAISON_AUTO=1
        # Le merge automatique passe par la GitHub App (jeton des Actions : pas de release)
        [ -n "$AVEC_APP" ] || attention_t bots.auto_no_app
    fi
    dim_t bots.desc_rythme
    demander bots.ask_each_ticket n && A_CHAQUE_TICKET=1
    demander bots.ask_preversion o || PREVERSION_OBLIGATOIRE=""
fi

# --- Outillage de la CI : langages du projet --------------------------------
# Même détection que les hooks (marqueurs des plugins, repowarden.skip), à la
# racine. strict activé seulement si le formatage et les tests de chaque
# langage ont leur outil (SANS_STRICT : raison sinon).
CI_LANGS=""
SANS_STRICT=""
sans_strict() { SANS_STRICT="${SANS_STRICT:+$SANS_STRICT, }$1"; }
active_plugins_init
for p in python node maven gradle go; do
    { [[ " $ACTIVE_PLUGINS " == *" $p "* ]] && has_marker . "$p"; } || continue
    CI_LANGS="$CI_LANGS $p"
    case "$p" in
        node) grep -q '"prettier"' package.json || sans_strict "prettier absent de package.json" ;;
        maven) grep -q spotless pom.xml || sans_strict "Spotless non configuré (pom.xml)" ;;
        gradle)
            find . -maxdepth 3 \( -name '*.gradle' -o -name '*.gradle.kts' \) -not -path '*/build/*' -print0 2>/dev/null |
                xargs -0 grep -qs spotless || sans_strict "Spotless non configuré (Gradle)"
            ;;
    esac
done
CI_LANGS="${CI_LANGS# }"

# Étapes d'installation de l'outillage des langages détectés (actions figées
# par SHA, comme les workflows de repowarden)
outillage_ci() {
    local p pm java=""
    for p in $CI_LANGS; do
        case "$p" in
            python)
                cat <<'YAML'
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
YAML
                [ ! -f requirements.txt ] || echo "      - run: pip install -r requirements.txt"
                cat <<'YAML'
      # Formatage, code mort et tests (versions figées)
      - run: pip install ruff==0.16.10 vulture==2.16 pytest==9.1.1
YAML
                ;;
            node)
                pm="$(node_pm)"
                cat <<'YAML'
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 24
YAML
                case "$pm" in
                    pnpm) echo "      - run: corepack enable && pnpm install --frozen-lockfile" ;;
                    yarn) echo "      - run: corepack enable && yarn install" ;;
                    *)
                        if [ -f package-lock.json ]; then
                            echo "          cache: npm"
                            echo "      - run: npm ci"
                        else
                            echo "      - run: npm install"
                        fi
                        ;;
                esac
                ;;
            maven | gradle)
                if [ -z "$java" ]; then
                    java=1
                    cat <<YAML
      - uses: actions/setup-java@de7274f081f381c8f8158605e0321c36c376e2e6 # v6.0.1
        with:
          distribution: temurin
          java-version: "21"
          cache: $p
YAML
                fi
                if [ "$p" = gradle ] && [ ! -x gradlew ]; then
                    cat <<'YAML'
      - uses: gradle/actions/setup-gradle@3f5f9adaf7d9fecd50b5935e54106014257a94e6 # v6.4.0
        with:
          gradle-version: current
YAML
                fi
                ;;
            go)
                cat <<'YAML'
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
YAML
                ;;
        esac
    done
}

# --- Modèles des workflows -------------------------------------------------
modele_ci() {
    cat <<'YAML'
# Vérifications repowarden en CI (obligatoires pour merger : repowarden proteger)
name: repowarden

on:
  pull_request:
    # edited : revérifie quand le titre de la PR change (message du commit en squash)
    types: [opened, synchronize, reopened, edited]
  push:
YAML
    if [ "$FLUX" = develop ]; then
        echo "    branches: [$PRINCIPALE, $INTEGRATION]"
    else
        echo "    branches: [$PRINCIPALE]"
    fi
    cat <<'YAML'
  # Lancé par le workflow de release sur sa PR (release-auto)
  workflow_dispatch:

permissions:
  contents: read
YAML
    [ "$FLUX" != develop ] || echo "  pull-requests: write # fix-pr : PR mal visée reciblée"
    cat <<'YAML'

jobs:
  repowarden:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0 # historique complet : messages de commit, diff depuis la base
YAML
    if [ -n "$CI_LANGS" ]; then
        echo "      # Outillage du projet ($CI_LANGS) : formatage et tests"
        outillage_ci
    else
        cat <<'YAML'
      # Outils du projet nécessaires au formatage et aux tests, par exemple :
      # - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
      #   with: { node-version: 24, cache: npm }
      # - run: npm ci
YAML
    fi
    echo "      - uses: simdevWarden/repowarden@v4"
    # strict : actif si l'outillage de chaque langage est installé ci-dessus
    local actif="" strict="strict: true   # outil absent bloquant, une fois l'outillage installé ci-dessus"
    if [ -n "$CI_LANGS" ]; then
        if [ -z "$SANS_STRICT" ]; then
            actif=1 strict="strict: true # outillage installé ci-dessus : un outil absent fait échouer"
        else
            strict="strict: true   # $SANS_STRICT : à activer une fois l'outil en place"
        fi
    fi
    if [ -n "$actif" ]; then
        echo "        with:"
        echo "          $strict"
    elif [ "$FLUX" = develop ]; then
        echo "        with:"
        echo "          # $strict"
    else
        echo "        # with:"
        echo "        #   $strict"
    fi
    if [ "$FLUX" = develop ]; then
        cat <<'YAML'
          # Seule la branche d'intégration entre dans la principale : une PR
          # de travail mal visée est reciblée avant les vérifications
          fix-pr: "true"
YAML
    fi
}

modele_release() {
    if [ "$FLUX" = develop ]; then
        if [ -n "$A_CHAQUE_TICKET" ]; then
            cat <<YAML
# Releases, flux $INTEGRATION → $PRINCIPALE (mode tag) : à chaque merge sur
# $INTEGRATION, préversion vX.Y.Z-next.N et demande de livraison
# $INTEGRATION → $PRINCIPALE, qui publie le tag vX.Y.Z et la release.
name: release

on:
  push:
    branches: [$PRINCIPALE, $INTEGRATION]
  workflow_dispatch: # à la main (et urgence) : préversion et demande de livraison
YAML
        else
            cat <<YAML
# Releases, flux $INTEGRATION → $PRINCIPALE (mode tag) : préversion vX.Y.Z-next.N le
# soir si $INTEGRATION a changé ; le vendredi matin (ou à la main), une demande
# de livraison $INTEGRATION → $PRINCIPALE, qui publie le tag vX.Y.Z et la release.
name: release

on:
  push:
    branches: [$PRINCIPALE, $INTEGRATION]
  schedule:
    - cron: "0 19 * * *" # préversion du soir, si $INTEGRATION a changé
    - cron: "0 7 * * 5" # fenêtre de livraison : le vendredi matin
  workflow_dispatch: # à la main (et urgence) : préversion et demande de livraison
YAML
        fi
        cat <<YAML

# Une file par branche et par déclencheur ; une demande manuelle ou planifiée
# remplace celle en attente ; un push n'annule jamais un run en cours
concurrency:
  group: release-\${{ github.ref_name }}-\${{ github.event.schedule || github.event_name }}
  cancel-in-progress: \${{ github.event_name != 'push' }}

permissions: {}

jobs:
  release:
    uses: simdevWarden/repowarden/.github/workflows/release-auto.yml@v4
    permissions: { contents: write, pull-requests: write, actions: write, checks: read, statuses: write, issues: read }
    with:
      mode: tag
      integration-branch: $INTEGRATION
      main-branch: $PRINCIPALE
YAML
        if [ -n "$A_CHAQUE_TICKET" ]; then
            cat <<'YAML'
      preversion-on-push: true # préversion à chaque merge
      delivery-on-push: true # demande de livraison à chaque merge
YAML
        else
            echo '      delivery-schedule: "0 7 * * 5" # même cron que la fenêtre ci-dessus'
        fi
        [ -n "$PREVERSION_OBLIGATOIRE" ] ||
            echo "      preversion-obligatoire: false # version stable possible sans préversion"
        if [ -n "$LIVRAISON_AUTO" ]; then
            echo "      delivery-auto: true # la GitHub App merge la livraison, vérifications vertes"
        elif [ -n "$LIVRAISON_ENV" ]; then
            echo "      delivery-environment: production # « Approve and deploy » valide la livraison"
        fi
        if [ -n "$AVEC_APP" ]; then
            local merge="la GitHub App merge la livraison approuvée"
            [ -z "$LIVRAISON_AUTO" ] || merge="la GitHub App merge la livraison"
            cat <<YAML
      app-client-id: \${{ vars.REPOWARDEN_APP_CLIENT_ID }} # $merge
    secrets:
      app-key: \${{ secrets.REPOWARDEN_APP_KEY }}
YAML
        fi
    else
        cat <<'YAML'
# Releases automatiques : à chaque merge sur la branche principale, la version
# (semver) est calculée depuis les Conventional Commits ; une PR « release
# x.y.z » est validée par la CI puis mergée, et le tag et la release créés.
name: release

on:
  push:
YAML
        echo "    branches: [$PRINCIPALE]"
        cat <<'YAML'
  workflow_dispatch:

# Une release à la fois
concurrency:
  group: release
  cancel-in-progress: false

permissions: {}

jobs:
  release:
    uses: simdevWarden/repowarden/.github/workflows/release-auto.yml@v4
    permissions: { contents: write, pull-requests: write, actions: write, checks: read, statuses: write, issues: read }
YAML
        if [ -n "$AVEC_APP" ]; then
            cat <<'YAML'
    with:
      app-client-id: ${{ vars.REPOWARDEN_APP_CLIENT_ID }}
    secrets:
      app-key: ${{ secrets.REPOWARDEN_APP_KEY }}
YAML
        fi
    fi
    # Tickets livrés : statut done et fermeture à la release, préprod à la
    # préversion ; seulement avec le suivi des tickets (sinon le job échoue)
    if choisi tickets || [ -e .github/workflows/tickets.yml ]; then
        cat <<'YAML'

  tickets:
    needs: release
    if: needs.release.outputs.release_created == 'true' || needs.release.outputs.prerelease_created == 'true'
    uses: simdevWarden/repowarden/.github/workflows/tickets.yml@v4
    permissions: { contents: write, issues: write, pull-requests: write, statuses: write }
    with:
      tag: ${{ needs.release.outputs.tag_name || needs.release.outputs.prerelease_tag }}
YAML
        if [ -n "$AVEC_APP" ]; then
            cat <<'YAML'
      app-client-id: ${{ vars.REPOWARDEN_APP_CLIENT_ID }}
    secrets:
      app-key: ${{ secrets.REPOWARDEN_APP_KEY }}
YAML
        fi
    fi
}

modele_nettoyage() {
    cat <<'YAML'
# Branches de PR supprimées après merge (la suppression automatique de GitHub
# est désactivée dans le flux develop : elle supprimerait la branche
# d'intégration au merge de la livraison). Les branches longues et toute
# branche encore source d'une PR ouverte sont conservées.
name: nettoyage

on:
  pull_request:
    types: [closed]

permissions: {}

jobs:
  nettoyage:
    uses: simdevWarden/repowarden/.github/workflows/nettoyage-branches.yml@v4
    permissions:
      contents: write
      pull-requests: read
YAML
}

fichier_du() { # $1 bot → REPLY : chemin de son workflow (vide : aucun)
    case "$1" in
        ci) REPLY=.github/workflows/repowarden.yml ;;
        release) REPLY=.github/workflows/release.yml ;;
        nettoyage) REPLY=.github/workflows/nettoyage.yml ;;
        *) REPLY="" ;;
    esac
}

# --- Aperçu, puis confirmation ---------------------------------------------
echo >&2
step_t bots.preview
[ -z "$CREER_DEVELOP" ] || info_t bots.prev_develop "$INTEGRATION" "$PRINCIPALE"
if [ "$FLUX" = develop ]; then
    info_t bots.prev_conf "$INTEGRATION"
    if [ -n "$LIVRAISON_AUTO" ]; then
        info_t bots.prev_conf_auto
    elif [ -z "$LIVRAISON_ENV" ]; then
        info_t bots.prev_review
    fi
fi
# Choix de livraison écrits dans release.yml (questions posées)
if [ "$FLUX" = develop ] && choisi release; then
    if [ -n "$LIVRAISON_AUTO" ]; then
        info_t bots.prev_delivery_auto
        [ -n "$AVEC_APP" ] || attention_t bots.auto_no_app
    else
        info_t bots.prev_delivery_approval
    fi
    if [ -n "$A_CHAQUE_TICKET" ]; then info_t bots.prev_each_ticket; else info_t bots.prev_grouped; fi
    if [ -n "$PREVERSION_OBLIGATOIRE" ]; then info_t bots.prev_preversion_on; else info_t bots.prev_preversion_off; fi
fi
for bot in ${BOTS[@]+"${BOTS[@]}"}; do
    fichier_du "$bot"
    f="$REPLY"
    if [ -n "$f" ]; then
        if [ -e "$f" ]; then
            ecart="$(diff <("modele_$bot") "$f" | grep -c '^[<>]' || true)"
            info_t bots.prev_kept "$f" "$ecart"
        else
            info_t bots.prev_file "$f"
            # Outillage écrit dans la CI, ou modèle générique faute de langage reconnu
            if [ "$bot" = ci ] && [ -n "$CI_LANGS" ]; then
                info_t bots.prev_ci_langs "$CI_LANGS"
            elif [ "$bot" = ci ]; then
                info_t bots.prev_ci_generic
            fi
        fi
    else
        info_t "bots.prev_$bot"
    fi
done
demander bots.ask_confirm n || { info_t bots.later; exit 0; }

# --- Application -----------------------------------------------------------
echecs=0
lancer() { # $1 bot, puis la commande : une erreur n'arrête pas les autres
    local bot="$1"
    shift
    echo >&2
    step_t "bots.run_$bot"
    if ! "$@"; then
        err_t bots.failed_one "$bot"
        echecs=$((echecs + 1))
    fi
}

if [ -n "$CREER_DEVELOP" ]; then
    sha="$(gh api "repos/$REPO/git/ref/heads/$DEFAUT" --jq .object.sha)"
    gh api -X POST "repos/$REPO/git/refs" -f "ref=refs/heads/$INTEGRATION" -f "sha=$sha" --silent
    ok_t bots.develop_created "$INTEGRATION" "$DEFAUT"
fi
if [ "$FLUX" = develop ]; then
    conf="$GIT_TOPLEVEL/.repowarden.conf"
    # Valeur déjà en place : fichier laissé tel quel (git config le réindenterait)
    [ "$(git config -f "$conf" --get repowarden.integrationBranch || true)" = "$INTEGRATION" ] ||
        git config -f "$conf" repowarden.integrationBranch "$INTEGRATION"
    git config -f "$conf" --get repowarden.protectedBranches >/dev/null ||
        git config -f "$conf" repowarden.protectedBranches "$PRINCIPALE $INTEGRATION"
    if [ -n "$LIVRAISON_AUTO" ]; then
        # Choix explicite : remplace une approbation déjà réglée
        [ "$(git config -f "$conf" --get repowarden.deliveryApproval || true)" = auto ] ||
            git config -f "$conf" repowarden.deliveryApproval auto
    elif [ -z "$LIVRAISON_ENV" ]; then
        git config -f "$conf" --get repowarden.deliveryApproval >/dev/null ||
            git config -f "$conf" repowarden.deliveryApproval review
    fi
    ok_t bots.conf_written .repowarden.conf
fi
for bot in ${BOTS[@]+"${BOTS[@]}"}; do
    fichier_du "$bot"
    f="$REPLY"
    if [ -n "$f" ]; then
        if [ -e "$f" ]; then
            info_t bots.kept "$f"
        else
            mkdir -p "${f%/*}"
            "modele_$bot" >"$f"
            ok_t bots.written "$f"
        fi
    fi
done
choisi tickets && lancer tickets bash "$BIN/tickets" init --repo "$REPO"
choisi app && lancer app bash "$BIN/app" init --repo "$REPO"
choisi proteger && lancer proteger bash "$BIN/proteger" --repo "$REPO"
choisi npm && lancer npm bash "$BIN/npm-publication" --repo "$REPO"

echo >&2
if [ "$echecs" = 0 ]; then
    ok_t bots.done
else
    attention_t bots.done_errors "$echecs"
fi
[ -z "$(git status --porcelain -- .github .repowarden.conf 2>/dev/null)" ] || info_t bots.commit_files
dim_t bots.verify
[ "$echecs" = 0 ]
