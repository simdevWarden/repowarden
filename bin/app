#!/usr/bin/env bash
# GitHub App du dépôt : identité d'automatisation des workflows repowarden.
# Ce que fait le jeton des Actions ne déclenche aucun workflow (PR brouillon
# sans CI, merge automatique sans préversion…) ; un jeton de l'App, si.
#
#   repowarden app init [--repo propriétaire/nom] [--nom NOM] [--administration]
#   repowarden app init --bot      App du bot d'organisation (repowarden bot),
#                                  dans le dépôt de pilotage : workflows et
#                                  administration en plus ; identifiants
#                                  REPOWARDEN_BOT_CLIENT_ID, REPOWARDEN_BOT_KEY
#
# 1. création (flux « manifest » de GitHub) : une page locale envoie la
#    description de l'App à GitHub, tu cliques sur « Create » ; permissions
#    minimales (contenu, PR, tickets, statuts ; administration seulement avec
#    --administration, pour appliquer la configuration depuis la CI) ;
# 2. identifiants rangés sans être affichés : variable REPOWARDEN_APP_CLIENT_ID,
#    secret REPOWARDEN_APP_KEY (clé privée) ;
# 3. installation sur le dépôt : « Install » (vérifiée avec la clé ; relance : « non vérifiée »).
# Relançable : une App déjà configurée n'est pas recréée. Demande gh et node.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

aide() { _tr help.app; printf '%b\n' "$_T" >&2; }

commande="${1:-}"
[ $# -eq 0 ] || shift
REPO="" NOM="" ADMIN="" BOT=""
while [ $# -gt 0 ]; do
    case "$1" in
        --repo) shift; REPO="${1:?--repo attend propriétaire/nom}" ;;
        --nom) shift; NOM="${1:?--nom attend un nom}" ;;
        --administration) ADMIN=1 ;;
        --bot) BOT=1 ADMIN=1 ;;
        -h | --help) aide; exit 0 ;;
        *) err_t install.unknown_arg "$1"; exit 1 ;;
    esac
    shift
done
if [ "$commande" != init ]; then
    aide
    [ -z "$commande" ] || [ "$commande" = -h ] || [ "$commande" = --help ]
    exit
fi

command -v gh >/dev/null || { err_t bot.no_gh; exit 1; }
command -v node >/dev/null || { err_t app.no_node; exit 1; }
[ -n "$REPO" ] || REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
owner="${REPO%%/*}"
NOM_DEMANDE="$NOM"
# App du bot : identifiants à part (dépôt de pilotage), droits sur les workflows
PREFIXE=REPOWARDEN_APP
if [ -n "$BOT" ]; then
    PREFIXE=REPOWARDEN_BOT
    NOM="${NOM:-repowarden-bot-$owner}"
fi
NOM="${NOM:-repowarden-$owner}"
brand "app · $REPO"

# Ouvre une adresse dans le navigateur (REPOWARDEN_OPEN : commande à utiliser)
ouvrir() {
    if [ -n "${REPOWARDEN_OPEN:-}" ]; then "$REPOWARDEN_OPEN" "$1"
    elif command -v open >/dev/null; then open "$1"
    elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1
    elif command -v cmd.exe >/dev/null; then cmd.exe /c start "" "$1"
    fi
}

# Conteneur dont le navigateur (sur l'hôte) ne joint pas 127.0.0.1 : la page
# locale et le retour de GitHub y seraient injoignables (App orpheline si
# « Create » est cliqué). VS Code Dev Containers et Codespaces redirigent les
# ports d'eux-mêmes. REPOWARDEN_CONTENEUR=0|1 force la réponse.
conteneur_isole() {
    case "${REPOWARDEN_CONTENEUR:-}" in 0) return 1 ;; 1) return 0 ;; esac
    [ -z "${REMOTE_CONTAINERS:-}${CODESPACES:-}${VSCODE_IPC_HOOK_CLI:-}" ] || return 1
    [ -e /.dockerenv ] || [ -e /run/.containerenv ] ||
        grep -qE 'docker|kubepods|containerd|lxc|podman' /proc/1/cgroup 2>/dev/null
}

# Marche à suivre quand la page locale n'est pas joignable : lancer sur l'hôte
marche_a_suivre() {
    local cmd="npx repowarden app init --repo $REPO"
    [ -z "$NOM_DEMANDE" ] || cmd="$cmd --nom $NOM_DEMANDE"
    if [ -n "$BOT" ]; then cmd="$cmd --bot"; elif [ -n "$ADMIN" ]; then cmd="$cmd --administration"; fi
    info_t app.howto "$cmd"
}

# 1. Création, si l'App n'est pas déjà configurée pour ce dépôt
step_t app.step_create
client_id="$(gh variable get "${PREFIXE}_CLIENT_ID" --repo "$REPO" 2>/dev/null || true)"
if [ -n "$client_id" ] && grep -q "^${PREFIXE}_KEY" <<<"$(gh secret list --repo "$REPO")"; then
    ok_t app.exists "$client_id"
    slug="$(gh variable get "${PREFIXE}_SLUG" --repo "$REPO" 2>/dev/null || true)"
else
    if [ "$(gh api "users/$owner" -q .type)" = Organization ]; then
        apps="https://github.com/organizations/$owner/settings/apps"
    else
        apps="https://github.com/settings/apps"
    fi
    cible="$apps/new"
    # Nom déjà pris (souvent une App orpheline d'un essai interrompu) : GitHub
    # refuserait la création ; arrêt avec la marche à suivre. Slug : nom en
    # minuscules, autres caractères en tirets ; une App privée d'un autre
    # compte reste invisible (rappel à l'ouverture de la page)
    slug_voulu="$(printf '%s' "$NOM" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
    if [ "$(gh api "apps/$slug_voulu" -q .slug 2>/dev/null || true)" = "$slug_voulu" ]; then
        err_t app.name_taken "$NOM"
        info_t app.name_taken_fix "$apps"
        exit 1
    fi
    if conteneur_isole; then
        err_t app.container
        marche_a_suivre
        exit 1
    fi
    sortie="$(mktemp)"
    trap 'rm -f "$sortie"' EXIT
    # Page locale : envoie la description à GitHub (formulaire POST), puis
    # reçoit le code de retour ; le code est écrit sur la sortie standard
    delai_page="${REPOWARDEN_APP_DELAI:-180}"
    NOM="$NOM" REPO="$REPO" ADMIN="$ADMIN" BOT="$BOT" CIBLE="$cible" DELAI_PAGE="$delai_page" node -e '
        const http = require("http"), crypto = require("crypto");
        const etat = crypto.randomBytes(16).toString("hex");
        // Page jamais consultée (navigateur qui ne joint pas 127.0.0.1) : arrêt
        const attente = setTimeout(() => { console.log("DELAI_PAGE"); process.exit(1); }, Number(process.env.DELAI_PAGE) * 1000);
        const srv = http.createServer((req, res) => {
            clearTimeout(attente);
            const u = new URL(req.url, "http://127.0.0.1");
            if (u.pathname === "/fin") {
                if (u.searchParams.get("state") !== etat) { res.writeHead(400); res.end("état invalide"); return; }
                res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
                res.end("<p>App créée : retourne au terminal.</p>");
                console.log("CODE " + u.searchParams.get("code"));
                res.on("finish", () => process.exit(0));
                return;
            }
            const port = srv.address().port;
            const perms = { contents: "write", pull_requests: "write", issues: "write", statuses: "write", metadata: "read" };
            if (process.env.ADMIN) perms.administration = "write";
            // Bot : PR de migration qui modifient les workflows des projets
            if (process.env.BOT) perms.workflows = "write";
            const manifeste = JSON.stringify({
                name: process.env.NOM, url: "https://github.com/" + process.env.REPO,
                // Webhook inactif : GitHub exige tout de même son adresse
                hook_attributes: { url: "https://github.com/" + process.env.REPO, active: false }, public: false,
                redirect_url: "http://127.0.0.1:" + port + "/fin", default_permissions: perms,
            }).replace(/&/g, "&amp;").replace(/"/g, "&quot;");
            res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
            res.end("<form id=f method=post action=\"" + process.env.CIBLE + "?state=" + etat + "\">" +
                "<input type=hidden name=manifest value=\"" + manifeste + "\"></form>" +
                "<script>document.getElementById(\"f\").submit()</script>");
        });
        srv.listen(0, "127.0.0.1", () => console.log("PORT " + srv.address().port));
        setTimeout(() => { console.log("DELAI"); process.exit(1); }, 15 * 60 * 1000);
    ' >"$sortie" &
    serveur=$!
    for _ in $(seq 1 50); do grep -q '^PORT ' "$sortie" && break; sleep 0.1; done
    port="$(sed -n 's/^PORT //p' "$sortie")"
    [ -n "$port" ] || { err_t app.server_failed; exit 1; }
    info_t app.open "http://127.0.0.1:$port/"
    dim_t app.name_hint "$NOM" "$apps"
    ouvrir "http://127.0.0.1:$port/"
    wait "$serveur" || true
    code="$(sed -n 's/^CODE //p' "$sortie")"
    if grep -q '^DELAI_PAGE' "$sortie"; then
        err_t app.page_timeout "$delai_page"
        marche_a_suivre
        exit 1
    fi
    if [ -z "$code" ]; then
        err_t app.no_code
        attention_t app.orphan
        info_t app.name_taken_fix "$apps"
        marche_a_suivre
        exit 1
    fi
    # Conversion du code : identifiants de l'App, rangés sans être affichés
    reponse="$(gh api -X POST "app-manifests/$code/conversions")"
    client_id="$(node -p 'JSON.parse(require("fs").readFileSync(0, "utf8")).client_id' <<<"$reponse")"
    slug="$(node -p 'JSON.parse(require("fs").readFileSync(0, "utf8")).slug' <<<"$reponse")"
    # Clé gardée en mémoire le temps de vérifier l'installation, jamais affichée
    cle="$(node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(0, "utf8")).pem)' <<<"$reponse")"
    printf '%s' "$cle" | gh secret set "${PREFIXE}_KEY" --repo "$REPO"
    reponse=""
    gh variable set "${PREFIXE}_CLIENT_ID" --repo "$REPO" --body "$client_id"
    gh variable set "${PREFIXE}_SLUG" --repo "$REPO" --body "$slug"
    ok_t app.created "$slug" "${PREFIXE}_CLIENT_ID" "${PREFIXE}_KEY"
fi

# 2. Installation sur le dépôt (vérifiée depuis tes installations)
step_t app.step_install
# Vérifiée au nom de l'App (jeton signé avec sa clé, valable 10 min) : le jeton
# de gh ne peut pas lister les installations d'une App
installee() {
    local jwt
    jwt="$(CLE="$cle" CID="$client_id" node -e '
        const c = require("crypto"), now = Math.floor(Date.now() / 1000);
        const b = (o) => Buffer.from(JSON.stringify(o)).toString("base64url");
        const t = b({ alg: "RS256", typ: "JWT" }) + "." + b({ iat: now - 60, exp: now + 540, iss: process.env.CID });
        process.stdout.write(t + "." + c.sign("RSA-SHA256", Buffer.from(t), process.env.CLE).toString("base64url"));
    ' 2>/dev/null)" || return 1
    gh api "repos/$REPO/installation" -H "Authorization: Bearer $jwt" >/dev/null 2>&1
}
cle="${cle:-}"
if [ -z "$cle" ]; then
    # Relance : la clé privée n'est pas ici, et le jeton de gh ne peut pas
    # lister les installations d'une App (user/installations : 403) ; état
    # « non vérifié » plutôt qu'un succès non constaté
    attention_t app.not_verified "${slug:-?}" "$REPO" "https://github.com/apps/${slug:-<slug>}/installations/new"
    exit 0
fi
if [ -n "$slug" ] && ! installee; then
    [ -z "$BOT" ] || info_t app.bot_all_repos
    info_t app.open "https://github.com/apps/$slug/installations/new"
    ouvrir "https://github.com/apps/$slug/installations/new"
    for _ in $(seq 1 120); do installee && break; sleep 5; done
fi
if [ -n "$slug" ] && installee; then
    cle=""
    ok_t app.installed "$slug" "$REPO"
else
    attention_t app.not_installed "$slug" "$REPO"
    exit 1
fi
echo
ok_t app.done
dim_t app.next
