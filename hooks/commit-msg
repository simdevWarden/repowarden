#!/usr/bin/env bash
# Hook commit-msg : impose le format Conventional Commits.
# Ex : "feat(auth): ajoute la connexion JWT", "fix: corrige le calcul de TVA"
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
exit_if_skipped
run_local_hook "$@"

MSG_FILE="$1"

# Agents IA : signatures retirées du message, identité d'agent refusée
if agents_refused; then
    agent_lines_r "$(cat "$MSG_FILE")"
    if [ -n "$REPLY" ]; then
        while IFS= read -r ligne; do attention_t hook.agent_stripped "$ligne"; done <<<"$REPLY"
        # grep -a : texte même avec un emoji (Windows le croirait binaire) ;
        # contenu réécrit dans le même fichier (git le garde ouvert sous Windows)
        filtre="$(LC_ALL=C grep -aviE "$AGENT_LINE_ERE" "$MSG_FILE" || true)"
        printf '%s\n' "$filtre" >"$MSG_FILE"
    fi
    for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
        id="$(git var "$ident" 2>/dev/null || true)"
        nom="${id%% <*}"
        mail="${id#*<}"
        mail="${mail%%>*}"
        if agent_identity "$nom" "$mail"; then
            err_t hook.agent_identity "$nom <$mail>"
            echo_t hook.agent_identity_fix
            exit 1
        fi
    done
fi
# Première ligne non commentée
SUBJECT="$(grep -v '^#' "$MSG_FILE" | sed -n 1p)"

# Commits générés par git : on laisse passer
if [[ "$SUBJECT" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
    exit 0
fi

# En-tête tenté mais refusé : type inconnu (ou en majuscules), description vide
if ! [[ "$SUBJECT" =~ $CC_PATTERN ]] &&
    [[ "$SUBJECT" =~ ^([A-Za-z]+)(\([^\)]*\))?(!?):[[:space:]]*(.*)$ ]]; then
    typ="${BASH_REMATCH[1]}" portee="${BASH_REMATCH[2]}" bang="${BASH_REMATCH[3]}" desc="${BASH_REMATCH[4]}"
    typ_min="$(printf '%s' "$typ" | tr '[:upper:]' '[:lower:]')"
    propose="$typ_min"
    [[ "$typ_min" =~ ^($CC_TYPES)$ ]] || { type_proche_r "$typ_min"; propose="$REPLY"; }
    if [ -z "$desc" ]; then
        err_t hook.commit_msg.desc_empty "${propose:-$typ}$portee$bang:"
        echo_t hook.commit_msg.kept >&2
        exit 1
    fi
    if [ "$propose" != "$typ" ]; then
        if [ -n "$propose" ]; then
            err_t hook.commit_msg.type_unknown "$typ" "$propose$portee$bang: $desc"
        else
            err_t hook.commit_msg.type_none "$typ"
            types_help
        fi
        echo_t hook.commit_msg.kept >&2
        exit 1
    fi
fi

if ! [[ "$SUBJECT" =~ $CC_PATTERN ]]; then
    if [ "${REPOWARDEN_LANG:-}" = en ]; then
        cat >&2 <<EOF
✖ Invalid commit message: "$SUBJECT"

Expected format: <type>(<optional scope>): <description>
  e.g.: feat(user): add sign-up
        fix: fix the database timeout
        refactor!: change the public API   (! = breaking change)

Types:
EOF
    else
        cat >&2 <<EOF
✖ Message de commit invalide : "$SUBJECT"

Format attendu : <type>(<scope optionnel>): <description>
  ex. : feat(user): ajoute l'inscription
        fix: corrige le timeout de la base
        refactor!: change l'API publique   (! = breaking change)

Types :
EOF
    fi
    types_help
    echo >&2
    # HEAD détachée (bisect, essai, rebase) : pas de branche dont tirer le
    # préfixe, le conseil de nommage ne s'applique pas
    if ! git symbolic-ref -q HEAD >/dev/null; then
        echo_t hook.commit_msg.detached >&2
        echo_t hook.commit_msg.kept >&2
    elif [ "${REPOWARDEN_LANG:-}" = en ]; then
        cat >&2 <<EOF
👉 Tip: name your branch <type>/<topic> (e.g. feat/user) and the prefix
   is added automatically: git commit -m "add sign-up"  (or use git cc)
   Your message is not lost: git commit -e -F .git/COMMIT_EDITMSG
EOF
    else
        cat >&2 <<EOF
👉 Astuce : nomme ta branche <type>/<sujet> (ex. feat/user) et le préfixe
   sera ajouté automatiquement : git commit -m "ajoute l'inscription"  (ou git cc)
   Ton message n'est pas perdu : git commit -e -F .git/COMMIT_EDITMSG
EOF
    fi
    exit 1
fi

# Point final retiré, comme dans git cc (pas des points de suspension) ; seule
# la première ligne est réécrite, le corps reste intact
if [[ "$SUBJECT" == *. && "$SUBJECT" != *.. ]]; then
    SUBJECT="${SUBJECT%.}"
    contenu="$(awk -v s="$SUBJECT" '!fait && !/^#/ { print s; fait = 1; next } { print }' "$MSG_FILE")"
    printf '%s\n' "$contenu" >"$MSG_FILE"
    info_t hook.commit_msg.dot >&2
fi

authored_length "$SUBJECT"
if [ "$REPLY" -gt 72 ]; then
    err_t hook.commit_msg.1 "$REPLY" >&2
    exit 1
fi
