#!/usr/bin/env bash
# Hook pre-push : build/tests complets selon le(s) langage(s) détecté(s).
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
source "$(dirname "$0")/lib/lang.sh"
source "$(dirname "$0")/lib/safety.sh"
exit_if_skipped
check_version
cd "$GIT_TOPLEVEL"

# git fournit les refs poussées sur stdin : on les transmet au hook local
REFS="$(cat)"
printf '%s\n' "$REFS" | run_local_hook "$@"

# Nommage des branches poussées (ligne : <ref locale> <sha> <ref distante> <sha>).
# Une suppression (sha local nul) n'est pas vérifiée : retirer une branche mal
# nommée doit rester possible.
if ! skipped branch-name; then
    while read -r _ local_sha remote_ref _; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        [[ "$local_sha" =~ ^0+$ ]] && continue
        branch="${remote_ref#refs/heads/}"
        if ! branch_name_valid "$branch"; then
            err_t hook.pre_push.1 >&2
            branch_help "$branch"
            exit 1
        fi
    done <<< "$REFS"
fi

# Branches protégées : elles n'évoluent que par Pull Request. Seule la création
# initiale sur le remote est permise (dépôt neuf).
if ! skipped protect-branch; then
    cfg_r protectedBranches "main master"
    PROTECTED="$REPLY"
    while read -r _ _ remote_ref remote_sha; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        branch="${remote_ref#refs/heads/}"
        [[ " $PROTECTED " == *" $branch "* ]] || continue
        [[ "$remote_sha" =~ ^0+$ ]] && continue
        err_t hook.pre_push.2 "$branch" >&2
        echo_t hook.pre_push.3 >&2
        exit 1
    done <<<"$REFS"
fi

REMOTE="${1:-origin}"

# Messages des commits poussés : même règle et mêmes messages que la CI, pour
# un commit créé hors hooks (autre outil, rebase sans hooks, --no-verify).
# Seuls les commits absents du remote sont vus : l'historique déjà poussé
# n'est pas rejugé.
if ! skipped commit-msg; then
    MSG_BAD=""
    while read -r _ local_sha remote_ref remote_sha; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        [[ "$local_sha" =~ ^0+$ ]] && continue
        if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            plage=("$remote_sha..$local_sha")
        else
            plage=("$local_sha" --not --remotes="$REMOTE")
        fi
        # Séparateur 0x1f (non blanc) : un champ vide ne décale pas les suivants
        while IFS=$'\x1f' read -r sha email subject; do
            [ -n "$sha" ] || continue
            commit_subject_problem_r "$subject" "$email"
            [ -n "$REPLY" ] || continue
            [ -n "$MSG_BAD" ] || err_t hook.pre_push.msg
            # git log va du plus récent au plus ancien : MSG_BAD finit sur le
            # plus ancien commit fautif, point de départ de la correction
            MSG_BAD="$sha"
            _tr "$REPLY" "${sha:0:7}" "$subject"
            echo "  $_T" >&2
        done < <(git log --no-merges --format='%H%x1f%ae%x1f%s' "${plage[@]}")
    done <<<"$REFS"
    if [ -n "$MSG_BAD" ]; then
        if git rev-parse -q --verify "$MSG_BAD^" >/dev/null; then
            echo_t hook.pre_push.msg_fix "${MSG_BAD:0:7}^" >&2
        else
            echo_t hook.pre_push.msg_fix "--root" >&2
        fi
        exit 1
    fi
fi

# Fichiers modifiés par le push de <sha> : depuis l'état distant connu, ou pour
# une nouvelle branche depuis le dernier commit déjà présent sur le remote.
changed_files() {
    local sha="$1" remote_sha="$2" oldest base=""
    if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        oldest="$(git rev-list "$sha" --not --remotes="$REMOTE" | tail -n1)"
        [ -z "$oldest" ] && return 0                       # déjà tout sur le remote
        base="$(git rev-parse -q --verify "$oldest^" || true)" # vide = premier push
    fi
    if [ -n "$base" ]; then
        git diff --name-only "$base" "$sha"
    else
        git ls-tree -r --name-only "$sha"
    fi
}

# Linting des fichiers modifiés (shellcheck, actionlint, etc.) : ce que la CI
# refusera doit être vu avant le push. Désactivable avec repowarden.skip lint.
if ! skipped lint; then
    # Sévérité shellcheck : warning (défaut), error, style. Config : repowarden.lintSeverity.
    cfg_r lintSeverity warning
    LINT_SEVERITY="$REPLY"

    # Commande d'installation suggérée selon l'OS
    lint_install_cmd() {
        case "$1" in
            shellcheck)
                case "${OSTYPE:-}" in
                    darwin*) printf 'brew install shellcheck' ;;
                    linux*)  printf 'apt-get install shellcheck' ;;
                    msys*|cygwin*|win*) printf 'choco install shellcheck' ;;
                    *) printf 'https://www.shellcheck.net/' ;;
                esac
                ;;
            actionlint)
                case "${OSTYPE:-}" in
                    darwin*) printf 'brew install actionlint' ;;
                    linux*)  printf 'go install github.com/rhysd/actionlint/cmd/actionlint@latest' ;;
                    msys*|cygwin*|win*) printf 'scoop install actionlint' ;;
                    *) printf 'https://github.com/rhysd/actionlint' ;;
                esac
                ;;
            *) printf '%s' "$1" ;;
        esac
    }

    # Vrai si le fichier $1 est un script shell (extension .sh/.bash ou shebang)
    is_shell_script() {
        local file="$1" first_line
        case "$file" in
            *.sh|*.bash) return 0 ;;
        esac
        # Pas d'extension reconnue : on lit la 1re ligne (shebang)
        IFS= read -r first_line <"$file" 2>/dev/null || return 1
        case "$first_line" in
            '#!/bin/sh'|'#!/bin/bash'|'#!/usr/bin/env sh'|'#!/usr/bin/env bash'|'#!/usr/bin/env -S bash'*)
                return 0 ;;
        esac
        return 1
    }

    lint_changed_files() {
        local changed_file rc=0
        # Les checks optionnels (style, info) ne sont activés que si la sévérité le demande
        local shellcheck_opts="--severity=$LINT_SEVERITY"
        case "$LINT_SEVERITY" in
            style|info) shellcheck_opts="$shellcheck_opts -o all" ;;
        esac
        while IFS= read -r changed_file; do
            [ -f "$changed_file" ] || continue
            if is_shell_script "$changed_file"; then
                if has shellcheck; then
                    step_t hook.pre_push.lint.run "shellcheck" "$changed_file"
                    # shellcheck disable=SC2086
                    shellcheck $shellcheck_opts "$changed_file" || rc=1
                else
                    local install_cmd; install_cmd="$(lint_install_cmd shellcheck)"
                    warn_t hook.pre_push.lint.missing "shellcheck" "$changed_file" "$install_cmd"
                    [ -n "${REPOWARDEN_WARN_FILE:-}" ] && return 1
                fi
            elif case "$changed_file" in .github/workflows/*.yml|.github/workflows/*.yaml) true;; *) false;; esac; then
                if has actionlint; then
                    step_t hook.pre_push.lint.run "actionlint" "$changed_file"
                    actionlint "$changed_file" || rc=1
                else
                    local install_cmd; install_cmd="$(lint_install_cmd actionlint)"
                    warn_t hook.pre_push.lint.missing "actionlint" "$changed_file" "$install_cmd"
                    [ -n "${REPOWARDEN_WARN_FILE:-}" ] && return 1
                fi
            fi
        done
        return "$rc"
    }

    LINT_FAILED=0
    while read -r _ local_sha _ remote_sha; do
        # suppression de branche : rien à lint
        if [ -z "$local_sha" ] || [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
        changed_files "$local_sha" "$remote_sha" | lint_changed_files || LINT_FAILED=1
    done <<<"$REFS"
    [ "$LINT_FAILED" -eq 0 ] || exit 1
fi

# Jeton gh sans le scope « workflow » : GitHub refuserait après le commit un
# push qui touche .github/workflows/ (OAuth App). Signalé avant, sans bloquer
# (un push par SSH passe). Le fichier poussé est regardé d'abord, sans gh :
# « gh auth status » (appel réseau) n'a lieu que si un workflow est poussé.
WORKFLOW_PUSHED=0
while read -r _ local_sha _ remote_sha; do
    # suppression de branche : rien à pousser
    if [ -z "$local_sha" ] || [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
    case "$(changed_files "$local_sha" "$remote_sha")" in
        *".github/workflows/"*) WORKFLOW_PUSHED=1; break ;;
    esac
done <<<"$REFS"

if [ "$WORKFLOW_PUSHED" -eq 1 ] && has gh; then
    if GH_SCOPES="$(gh auth status 2>&1)"; then
        case "$GH_SCOPES" in
            *workflow*) ;;
            *) attention_t hook.pre_push.workflow_scope ;;
        esac
    fi
fi

skipped tests && { info "Tests désactivés (repowarden.skip)."; exit 0; }

run_tests_for() { test_projects <"$1"; }

TESTED=""
CHANGED="$(git rev-parse --absolute-git-dir)/repowarden-changed-files"
while read -r _ local_sha _ remote_sha; do
    # suppression de branche : rien à tester
    if [ -z "$local_sha" ] || [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
    [[ " $TESTED " == *" $local_sha "* ]] && continue
    TESTED="$TESTED $local_sha"
    changed_files "$local_sha" "$remote_sha" >"$CHANGED"
    if [ ! -s "$CHANGED" ] && [ -z "$(cfg test)" ]; then
        info_t hook.pre_push.5 "${local_sha:0:7}"
        continue
    fi
    # Teste le commit poussé tel qu'il sera sur le serveur
    run_on_commit "$local_sha" run_tests_for "$CHANGED"
done <<<"$REFS"

rm -f "$CHANGED"
# Entrée vide : git n'a rien à envoyer (« Everything up-to-date »)
if [ -z "$REFS" ]; then
    info_t hook.pre_push.nothing
elif [ -z "$TESTED" ]; then
    info_t hook.pre_push.6
fi
ok_t hook.pre_push.7
