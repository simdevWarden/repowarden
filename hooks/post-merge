#!/usr/bin/env bash
# Hook post-merge (après git pull) : supprime les branches locales dont la
# branche distante a été supprimée (PR mergée) ET entièrement intégrées, y
# compris par un merge squash. Une branche dont des modifications manquent est
# conservée : aucune perte possible. Désactivable : skip = prune-branches.
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
source "$(dirname "$0")/lib/tickets.sh"
exit_if_skipped
run_local_hook "$@"
# Branches locales des tickets qui me sont assignés (au plus toutes les 15 min)
tickets_sync || true
# Carte du projet déjà générée (repowarden carte) : recalculée après la fusion,
# hors ligne (ni gh ni réseau), sans jamais faire échouer le hook
if [ -n "$GIT_TOPLEVEL" ] && [ -f "$GIT_TOPLEVEL/.repowarden/carte/carte.json" ] && has jq; then
    REPOWARDEN_CARTE_HORS_LIGNE=1 bash "$(dirname "$0")/../bin/carte" >/dev/null 2>&1 || true
fi
skipped prune-branches && exit 0

current="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
remote="$(git config --get "branch.$current.remote" || true)"
# Seulement après un pull (branche suivie) : met à jour la liste des branches
# supprimées sur le serveur. Hors ligne : ignoré silencieusement.
[ -n "$remote" ] || exit 0
git remote prune "$remote" >/dev/null 2>&1 || exit 0

# Vrai si toutes les modifications de la branche $1 sont déjà dans la branche
# courante (merge squash) : la branche est résumée en un seul commit, que
# `git cherry` retrouve dans l'historique s'il a un équivalent.
squash_merged() {
    local base tree summary
    base="$(git merge-base HEAD "$1")" || return 1
    tree="$(git rev-parse "$1^{tree}")"
    summary="$(git commit-tree "$tree" -p "$base" -m repowarden-squash-check)"
    [[ "$(git cherry HEAD "$summary")" == "-"* ]]
}

git for-each-ref --format='%(refname:short)%09%(upstream:track)' refs/heads |
    while IFS=$'\t' read -r branch track; do
        [ "$track" = "[gone]" ] || continue
        [ "$branch" = "$current" ] && continue
        if git branch -d -q "$branch" 2>/dev/null; then
            echo_t hook.post_merge.1 "$branch"
        elif squash_merged "$branch" && git branch -D -q "$branch"; then
            echo_t hook.post_merge.2 "$branch"
        else
            info_t hook.post_merge.3 "$branch"
            echo_t hook.post_merge.4 "$branch"
        fi
    done
exit 0
