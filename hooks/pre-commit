#!/usr/bin/env bash
# Hook pre-commit : bloque les commits directs sur main, détecte les secrets,
# puis formate les fichiers stagés selon le(s) langage(s) détecté(s).
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
source "$(dirname "$0")/lib/lang.sh"
source "$(dirname "$0")/lib/safety.sh"
source "$(dirname "$0")/lib/secrets.sh"
exit_if_skipped
check_version
cd "$GIT_TOPLEVEL"

run_local_hook "$@"

BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"

# 0. Nommage de la branche
if ! skipped branch-name && ! branch_name_valid "$BRANCH"; then
    err_t hook.pre_commit.1 >&2
    branch_help "$BRANCH"
    exit 1
fi

# 1. Pas de commit direct sur les branches protégées (sauf commit initial)
PROTECTED="$(cfg protectedBranches "main master")"
if ! skipped protect-branch && [[ " $PROTECTED " == *" $BRANCH "* ]] && git rev-parse --verify -q HEAD >/dev/null; then
    err_t hook.pre_commit.2 "$BRANCH" >&2
    echo_t hook.pre_commit.3 >&2
    exit 1
fi

# 2. Détection de secrets
if ! skipped secrets; then
    if has gitleaks; then
        step_t hook.pre_commit.4
        # Journal de gitleaks tu (horodatage, couleurs à chaque commit) ; ses
        # trouvailles lues dans un rapport JSON. Code 42 : fuite ; tout autre
        # code non nul : gitleaks en échec (jamais présenté comme une fuite)
        rapport="$(mktemp)"
        journal="$(mktemp)"
        code=0
        gitleaks git --pre-commit --staged --redact --no-banner --log-level error \
            --report-format json --report-path "$rapport" --exit-code 42 >/dev/null 2>"$journal" || code=$?
        if [ "$code" -ne 0 ]; then
            if [ "$code" -eq 42 ]; then
                err_t hook.pre_commit.5 >&2
                secrets_report "$rapport" >&2
            else
                err_t hook.secrets.failed "$code" >&2
                cat "$journal" >&2
            fi
            rm -f "$rapport" "$journal"
            exit 1
        fi
        rm -f "$rapport" "$journal"
    else
        # Installation adaptée au système (bash le connaît sans sous-processus)
        case "${OSTYPE:-}" in
            darwin*) warn_t hook.pre_commit.6 "brew install gitleaks" ;;
            msys* | cygwin* | win*) warn_t hook.pre_commit.6 "winget install gitleaks" ;;
            *) warn_t hook.pre_commit.6 "https://github.com/gitleaks/gitleaks#installing" ;;
        esac
    fi
fi

# 3. Formatage : chaque fichier stagé avec l'outil de son langage / projet
if ! skipped format; then
    # Ne formater (et re-stager) que le contenu stagé, jamais le travail en cours
    hide_unstaged
    format_staged
    restore_unstaged
fi

ok_t hook.pre_commit.7
