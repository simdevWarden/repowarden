#!/usr/bin/env bats
# ci/verrous-pip.sh : verrous pip d'une PR Dependabot régénérés avec la
# commande de leur en-tête (uv simulé, remote nu local).

load helpers

VERROUS="$BATS_TEST_DIRNAME/../ci/verrous-pip.sh"
CMD_TESTS="pip compile --generate-hashes --universal --python-version 3.12 ci/requirements/tests.in -o ci/requirements/tests.txt"

# Verrou $1 : en-tête uv (arguments $2) puis le contenu $3
verrou() {
    mkdir -p "$(dirname "$1")"
    printf '# This file was autogenerated by uv via the following command:\n#    uv %s\n%s\n' "$2" "$3" >"$1"
}

# Faux uv : journalise ses arguments et écrit la sortie (-o) avec $UV_CONTENU,
# comme le vrai (en-tête reprenant la commande)
fake_uv() {
    mkdir -p "$BATS_TEST_TMPDIR/bin"
    cat >"$BATS_TEST_TMPDIR/bin/uv" <<'UV'
#!/usr/bin/env bash
echo "$*" >>"$UV_LOG"
prec="" sortie=""
for a in "$@"; do [ "$prec" != -o ] || sortie="$a"; prec="$a"; done
printf '# This file was autogenerated by uv via the following command:\n#    uv %s\n%s\n' "$*" "$UV_CONTENU" >"$sortie"
UV
    chmod +x "$BATS_TEST_TMPDIR/bin/uv"
    export PATH="$BATS_TEST_TMPDIR/bin:$PATH" UV_LOG="$BATS_TEST_TMPDIR/uv.log"
    export UV_CONTENU="ruff==2.0 ; python_full_version < '3.13'"
    : >"$UV_LOG"
}

# develop avec deux verrous conformes, puis branche Dependabot qui modifie
# tests.txt avec le contenu $1 (marqueurs perdus ou non)
pr_dependabot() {
    verrou ci/requirements/tests.txt "$CMD_TESTS" "ruff==1.0 ; python_full_version < '3.13'"
    verrou docs/requirements.txt "pip compile --generate-hashes --universal --python-version 3.12 docs/requirements.in -o docs/requirements.txt" "mkdocs==1.0"
    git add -A
    git commit -q -m "build: verrous"
    git push -q origin HEAD:develop
    export BASE_SHA="$(git rev-parse HEAD)" HEAD_REF=dependabot/pip/python
    git checkout -q -b "$HEAD_REF"
    verrou ci/requirements/tests.txt "$CMD_TESTS" "$1"
    git commit -q -am "build(deps): bump ruff"
    git push -q origin HEAD
    export REPOWARDEN_BOT_NAME="repowarden-app[bot]" REPOWARDEN_BOT_EMAIL="1+repowarden-app[bot]@users.noreply.github.com"
}

@test "verrous-pip : verrou touche non conforme regenere, commit du bot pousse" {
    setup_repo
    fake_uv
    pr_dependabot "ruff==2.0"
    run "$VERROUS"
    [ "$status" -eq 0 ]
    [ "$(cat "$UV_LOG")" = "$CMD_TESTS" ]
    git fetch -q origin
    [ "$(git log -1 --format='%an|%s' origin/dependabot/pip/python)" = "repowarden-app[bot]|build(deps): verrous pip régénérés avec uv" ]
    git show origin/dependabot/pip/python:ci/requirements/tests.txt | grep -qF "ruff==2.0 ; python_full_version < '3.13'"
}

@test "verrous-pip : verrou deja conforme -> aucun commit" {
    setup_repo
    fake_uv
    pr_dependabot "$UV_CONTENU"
    avant="$(git rev-parse HEAD)"
    run "$VERROUS"
    [ "$status" -eq 0 ]
    [ -s "$UV_LOG" ]
    [ "$(git rev-parse HEAD)" = "$avant" ]
    [ "$(git rev-parse origin/dependabot/pip/python)" = "$avant" ]
    [[ "$output" == *"aucun commit"* ]] || false
}

@test "verrous-pip : verrou non touche par la PR non relance" {
    setup_repo
    fake_uv
    pr_dependabot "ruff==2.0"
    run "$VERROUS"
    [ "$status" -eq 0 ]
    ! grep -q docs/requirements "$UV_LOG"
}

@test "verrous-pip : en-tete dont la sortie n'est pas le verrou refuse" {
    setup_repo
    fake_uv
    pr_dependabot "ruff==2.0"
    verrou ci/requirements/tests.txt "pip compile tests.in -o /tmp/ailleurs.txt" "ruff==2.0"
    git commit -q -am "build(deps): bump ruff"
    avant="$(git rev-parse HEAD)"
    run "$VERROUS"
    [ "$status" -eq 0 ]
    [ ! -s "$UV_LOG" ]
    [ "$(git rev-parse HEAD)" = "$avant" ]
    [[ "$output" == *"ci/requirements/tests.txt ignoré"* ]] || false
}
